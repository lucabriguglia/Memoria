@page "/dcb/projections/detail"
@using Memoria.EventSourcing.Dcb
@using Memoria.EventSourcing.Dcb.Store.EntityFrameworkCore
@using Memoria.Web.Extensibility
@using Microsoft.AspNetCore.WebUtilities
@inject DomainTypeRegistry Types
@inject IDcbDbContext StoreContext
@inject IDcbDomainService Folds
@inject NavigationManager Navigation

<PageTitle>@Heading @Title</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <a href="dcb">DCB</a>
    <span aria-hidden="true">/</span>
    <a href="dcb/projections">Projections</a>
    <span aria-hidden="true">/</span>
    @* The list this row was opened from, narrowed to the projection and the identifier that address
       it, so the step back arrives where the click came from. Neither of those is a crumb of its
       own: they are what the list is filtered by rather than places above this one, which is why
       the list itself dropped them too. *@
    <a href="@BackToList">Data</a>
    <span aria-hidden="true">/</span>
    @* What the page is, rather than which row reached it. The trail says where this sits; the
       heading and the tags below it say which one is open, and the browser tab still carries the
       values so two of these are told apart where they have to be. *@
    <span aria-current="page">Detail</span>
</nav>

@if (Projection is null || Identifier is null)
{
    <h1>@Heading</h1>
    <p class="alert" role="alert">
        That projection and identifier are not among the registered types. They may have been
        replaced by a later upload — start again from <a href="dcb/projections/types">projections</a>.
    </p>
}
else
{
    @* Named as every list here names a type: what it is bound as, and the version of that
       binding. Two versions of one name are two projections, and the heading has to say which. *@
    <div class="page-header">
        <h1>@Heading</h1>

        @* Across from the name, because it is about the name: the heading says what this row was
           folded into, and this is the way to what that type actually declares. Not among the tabs
           under it — those are five views of this one stored row, and the type is true of every row
           of it. The mark is the one the types pages are entered by everywhere else. *@
        <a class="button-mark quiet" href="@ViewTypeLink(TypeView.InfoTab)">
            <SectionMark Kind="SectionKind.Types"/>
            View Type
        </a>
    </div>

    @* The store failing to answer for the projection at all, which leaves both the facts and the
       state without their values — so it is said once, above the tabs, rather than in each. *@
    @if (Error is not null)
    {
        <p class="alert" role="alert">@Error</p>
    }

    @* Five views of one projection, switched by the address rather than by script: each tab is a
       link, so a view can be linked to and gone back to, and the page stays statically rendered
       like the rest of them. Marked with aria-current for the same reason the breadcrumb is —
       these are places to go, not scripted tabs, so they say so in the language of navigation.
       The four that read come first and the one that writes comes last. *@
    <nav class="tabs" aria-label="Projection views">
        <a id="tab-@InfoTab" href="@TabLink(InfoTab)"
           aria-current="@(Tab == InfoTab ? "page" : null)">Info</a>
        <a id="tab-@StateTab" href="@TabLink(StateTab)"
           aria-current="@(Tab == StateTab ? "page" : null)">State</a>
        <a id="tab-@JsonTab" href="@TabLink(JsonTab)"
           aria-current="@(Tab == JsonTab ? "page" : null)">Json</a>
        <a id="tab-@EventsTab" href="@TabLink(EventsTab)"
           aria-current="@(Tab == EventsTab ? "page" : null)">Events</a>
        @* Reads, like the four before it, but of two folds of the boundary rather than of the row —
           so it comes after the history it folds and before the one tab that writes. *@
        <a id="tab-@CompareTab" href="@TabLink(CompareTab)"
           aria-current="@(Tab == CompareTab ? "page" : null)">Compare</a>
        <a id="tab-@UpdateTab" href="@TabLink(UpdateTab)"
           aria-current="@(Tab == UpdateTab ? "page" : null)">Update</a>
    </nav>

    @* Each panel is named by the tab that reaches it, so the label is written once and a reader
       arriving by fragment is told which of the six they landed in. *@
    @if (Tab == InfoTab)
    {
        <section class="tab-panel" aria-labelledby="tab-@InfoTab">
            <dl class="facts">
                <dt>Identifier</dt>
                <dd>
                    @if (Identifier is { } identifier)
                    {
                        <code>@identifier.Name</code>
                    }
                    else
                    {
                        <span class="missing">Nothing registered writes ids of this shape</span>
                    }
                </dd>

                @* One row, however many tags it selects on, with the word for how they combine
                   beside them rather than folded into the line. *@
                <dt>Tags</dt>
                <dd>
                    @if (Tags is not null)
                    {
                        <code>@Tags.Text</code>

                        @if (Tags.Combination is { } combination)
                        {
                            <span class="hint">@combination</span>
                        }
                    }
                    else
                    {
                        @* Said here rather than left blank, because a page with no boundary is a
                           page whose tabs have nothing to show, and this is the first place that is
                           true. *@
                        <span class="missing">could not be worked out from those values</span>
                    }
                </dd>

                @* All of these off the row rather than out of the payload: the store's account of
                   the write, not the model's own state. The version is the stored one, so a
                   snapshot left behind while later events accumulate reads lower here than folding
                   its boundary would give — and the position below says how far along the log that
                   fold stopped. *@
                @if (Stored is not null)
                {
                    @* What the row is filed under, whole: its kind, the store id, and the digest of
                       the boundary above the tabs. Shown as the store wrote it rather than taken
                       apart, because this is the value that finds the row again in the table. *@
                    <dt>Id</dt>
                    <dd><code>@Stored.Id</code></dd>

                    @* The model's own id inside that key, carrying the type version after it — the
                       column the list this page was opened from leads with, so a reader arriving
                       here can match the row they clicked. *@
                    <dt>Store id</dt>
                    <dd><code>@Stored.StoreId</code></dd>
                    
                    <dt>Model type</dt>
                    @* The key the row was written under, said the way a version is said rather
                       than as the store joins it. Read off the row rather than off the type: this
                       block is the store's account of the write. *@
                    <dd><code>@DomainTypeDescriber.LabelOfKey(Stored.ModelType)</code></dd>

                    <dt>Version</dt>
                    <dd>
                        @Stored.Version

                        @* Said where the number it is about is read, and only when the two have come
                           apart: a version below the count of the events the projection applies is a
                           row the log has moved on from since it was written. *@
                        @if (Lag is { } lag)
                        {
                            <SnapshotWarning Note="lag.Note" UpdateHref="@TabLink(UpdateTab)"/>
                        }
                    </dd>

                    <dt>Latest position</dt>
                    <dd>@Stored.LatestPosition</dd>

                    <dt>Created</dt>
                    <dd>@Stored.Created.ToLocalTime().ToString("g")</dd>

                    @* Audit is a store concern the application may leave switched off, so a row
                       nobody is named against is an ordinary row rather than a broken one. *@
                    <dt>Created by</dt>
                    <dd>
                        @if (Stored.CreatedBy is { Length: > 0 } createdBy)
                        {
                            @createdBy
                        }
                        else
                        {
                            <span class="missing">not attributed</span>
                        }
                    </dd>

                    <dt>Updated</dt>
                    <dd>@Stored.Updated.ToLocalTime().ToString("g")</dd>

                    <dt>Updated by</dt>
                    <dd>
                        @if (Stored.UpdatedBy is { Length: > 0 } updatedBy)
                        {
                            @updatedBy
                        }
                        else
                        {
                            <span class="missing">not attributed</span>
                        }
                    </dd>
                }
            </dl>
        </section>
    }
    else if (Tab == StateTab)
    {
        <section class="tab-panel" aria-labelledby="tab-@StateTab">
            @if (Error is not null)
            {
                @* Said above the tabs already; nothing to add here but the absence. *@
                <p class="missing">There is no state to show.</p>
            }
            else if (Loaded is null)
            {
                @* Only the snapshots table is read, so this says nothing about the events: a
                   boundary can hold events that have never been folded into a row, and there would
                   still be nothing to show here. A projection's row is written by a read that folds
                   it, so the update tab is the way to make one. *@
                <p class="empty">
                    No snapshot is stored under those values. Nothing has been written under the
                    boundary they describe, or it was written under a wider one.
                </p>
            }
            else if (State.Count == 0)
            {
                <p class="missing">It declares no properties of its own.</p>
            }
            else
            {
                <table class="grid">
                    <thead>
                    <tr>
                        <th scope="col">Property</th>
                        <th scope="col">Type</th>
                        <th scope="col">Value</th>
                    </tr>
                    </thead>
                    <tbody>
                    @StateRows((State, 0))
                    </tbody>
                </table>
            }
        </section>
    }
    else if (Tab == JsonTab)
    {
        @* The payload as the store wrote it, laid out to be read. The state tab reads the same
           payload through the model's own properties; this shows the text those were read from, so
           a payload the model cannot open, or one holding more than the model declares, is still
           there to look at. Laid out by the server as text, like the rest of the page. *@
        <section class="tab-panel" aria-labelledby="tab-@JsonTab">
            @if (Error is not null)
            {
                @* Said above the tabs already; nothing to add here but the absence. *@
                <p class="missing">There is no payload to show.</p>
            }
            else if (Stored is null)
            {
                <p class="empty">
                    No snapshot is stored under those values. Nothing has been written under the
                    boundary they describe, or it was written under a wider one.
                </p>
            }
            else
            {
                @* The same card the pop-up over an event table holds, because it is the same
                   question about a different row: what the store actually wrote. *@
                <JsonPanel Data="@Stored.Data"/>
            }
        </section>
    }
    else if (Tab == EventsTab && Boundary is not null)
    {
        @* Narrowed to what this projection applies, so the count agrees with the version on the
           info tab, and shown whether or not a snapshot was found: the events are inside the
           boundary either way, and a boundary holding events with no snapshot written over them is
           worth being able to see. *@
        @* Focusable as well as linkable: a fragment scrolls the panel into view, and the negative
           tabindex means the browser moves focus to it too, so tabbing on from a pager link carries
           on inside the table rather than from the top of the document. *@
        <section class="tab-panel" id="@EventsAnchor" tabindex="-1" aria-labelledby="tab-@EventsTab">
            @if (Events.Error is not null)
            {
                <p class="alert" role="alert">@Events.Error</p>
            }
            else if (Events.Total == 0 && !IsNarrowed)
            {
                @* Nothing found and nothing there are two different answers. This is the second:
                   the history is empty, so there is nothing for a filter row to narrow and none is
                   drawn. A narrowed table that matched nothing is answered below, where the row
                   that narrowed it is still there to undo. *@
                <p class="missing">This projection applies no events inside the boundary.</p>
            }
            else
            {
                @* The whole count, not this page's worth: the pager says which page, and what a
                   reader wants beside it is how much there is to page through.

                   Above the filter row and outside the card, because it is the panel saying what it
                   found rather than part of the table it found it in — and because the filter row
                   below has to sit against the table for the two to read as one object. *@
                @if (Events.Total > 0)
                {
                    <p class="lede">@EventSummary</p>
                }

                @* Above the table, because it says what the table holds. Its own GET form, like the
                   rows-per-page picker under the table: the narrowing is a link to a narrower
                   history, so it belongs in the address bar where it can be bookmarked, shared and
                   gone back to. Everything that addresses the projection travels in hidden fields,
                   along with the order and the fold, so narrowing does not silently reorder the
                   table or shut its payloads. The page deliberately does not travel: page four of
                   one type is not page four of another.

                   The dropdown submits on change and the box is typed into, so the button is not
                   only the fallback when scripting is off — it submits both at once, which is what
                   one form buys. *@
                <form class="search" method="get" action="dcb/projections/detail#@EventsAnchor">
                    <label for="event">Event type</label>
                    <select id="event" name="event" onchange="this.form.submit()">
                        @* First and default, so a reader who has chosen nothing is looking at the
                           whole history rather than at whichever type happened to be listed
                           first. An empty value, which is what the address carries when nothing is
                           narrowed to. *@
                        <option value="" selected="@Choice.IsAll">All</option>
                        @foreach (var applied in EventTypes)
                        {
                            <option value="@(applied.FullName)" selected="@(applied == Choice.Chosen)">
                                @DomainTypeDescriber.OptionLabelOf(applied)
                            </option>
                        }
                    </select>

                    @* Beside the type rather than under it, because the two narrow the same list: a
                       type is what the log wrote a row under, and this is what the row itself
                       carries. The payload and nothing else — a history is short enough to run an
                       eye down the positions of, so the box is left to the thing a reader only half
                       remembers. *@
                    <label class="visually-hidden" for="text">Filter by payload</label>
                    <input id="text" type="search" name="text" value="@Text"
                           placeholder="Filter by payload" autocomplete="off"/>

                    <input type="hidden" name="type" value="@Projection.FullName"/>
                    <input type="hidden" name="id" value="@Identifier.FullName"/>
                    @foreach (var parameter in Parameters)
                    {
                        <input type="hidden" name="@parameter.Name"
                               value="@Values.GetValueOrDefault(parameter.Name)"/>
                    }
                    <input type="hidden" name="tab" value="@EventsTab"/>
                    <input type="hidden" name="dir" value="@(Descending ? "desc" : "asc")"/>
                    <input type="hidden" name="size" value="@PageSize"/>
                    @if (PayloadsOpen)
                    {
                        <input type="hidden" name="payloads" value="@Open"/>
                    }
                    <button type="submit" class="quiet">Filter</button>
                    @if (IsNarrowed)
                    {
                        <a href="@ClearLink">Clear</a>
                    }

                    @* Held to the right-hand end of the filter row. It belongs with the controls
                       that act on the whole table rather than in a strip of its own between the
                       filter and the data, which is all that strip had left in it once the count
                       moved up above the card.

                       Opens or closes every payload on the page at once. A link rather than a
                       control with script behind it, like the order and the page beside it: the
                       state lives in the address, so a page opened out can be linked to and gone
                       back to, and the rows stay foldable one at a time either way. It stays on
                       this page — this is a way of looking at the rows, not a way of moving
                       between them. *@
                    <a class="fold-all" href="@FoldLink">
                        @(PayloadsOpen ? "Collapse all" : "Expand all")
                        <span class="arrow @(PayloadsOpen ? "up" : "down")" aria-hidden="true"></span>
                    </a>
                </form>

                @if (Events.Total == 0)
                {
                    <p class="empty">
                        @* Nothing matched, and why is worth saying: a name in the address that
                           reaches nothing, a type the log could never have written, text that is
                           there to retype, or a type this history simply holds none of. The two
                           about the type come first — with either of them the text was never asked
                           about, so blaming it would send a reader to retype something that was
                           not the problem. *@
                        @if (Choice.Unknown)
                        {
                            <text>That event is not among the types this projection applies.</text>
                        }
                        else if (Choice.Unbound)
                        {
                            @* Applied, offered, and impossible to have stored: without an
                               [EventType] there is no key to write it under. *@
                            <text>
                                It carries no <code>[EventType]</code>, so the log has never
                                written one of these.
                            </text>
                        }
                        else if (IsFiltered)
                        {
                            <text>No payload matches &ldquo;@Text&rdquo;.</text>
                        }
                        else
                        {
                            <text>This projection applies no events of this type inside the boundary.</text>
                        }
                    </p>
                }
                else
                {
                    <table class="grid events compared">
                        <thead>
                        <tr>
                            @* Whether the stored snapshot has applied the row, as a mark and no
                               word: a column headed "Applied" would say what the mark says, and
                               the two marks tell the rows apart on their own. A heading for screen
                               readers only, so the column is still named where it is read out. *@
                            <th scope="col" class="col-applied"><span class="visually-hidden">Applied</span></th>
                            <th scope="col" class="col-position">Position</th>
                            <th scope="col" class="col-appended" aria-sort="@(Descending ? "descending" : "ascending")">
                                @* The only date these have, so the only thing there is to order them by. *@
                                <a href="@EventsLink(!Descending, 1)">
                                    Appended
                                    <span class="arrow @(Descending ? "down" : "up")" aria-hidden="true"></span>
                                </a>
                            </th>
                            @* What the log wrote the row under, as one name: the version is part of what
                               a type is called rather than a fact beside it, and it is said only from
                               the second version on — a first is what a name means until a second
                               exists, and a column whose every row ended in v1 would teach its reader
                               to skip it. *@
                            <th scope="col" class="col-type">Type</th>
                            <th scope="col" class="col-payload">Payload</th>
                            @* The same payload as the column before it, and the other question
                               about it: that one opens what the row was read into, this one opens
                               what the store actually wrote. Last, because it is a way to something
                               rather than a value to run an eye down. *@
                            <th scope="col" class="col-json marked">Json</th>
                            @* What the row did to the projection: the version it produced against the
                               one before. A way to something, like the column before it, so it
                               sits with it at the end. *@
                            <th scope="col" class="col-compare">Compare</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var stored in Events.Events)
                        {
                            <tr>
                                <td class="col-applied">
                                    <AppliedMark Applied="AppliedEvent.Is(stored.Position, Stored?.LatestPosition)"/>
                                </td>
                                <td>@stored.Position</td>
                                <td>@stored.Written.ToLocalTime().ToString("g")</td>
                                @* Name and version as one, the way every list here names a type, so a
                                   type met in a history and the same type met on its own page read
                                   alike. A key the store wrote that cannot be taken apart is left whole
                                   rather than half-read. *@
                                <td><code>@DomainTypeDescriber.LabelOfKey(stored.Type)</code></td>
                                <td>
                                    @if (stored.Error is not null)
                                    {
                                        <span class="missing">@stored.Error</span>
                                    }
                                    else if (stored.State.Count == 0)
                                    {
                                        <span class="missing">It carries nothing of its own.</span>
                                    }
                                    else
                                    {
                                        @* Folded away, and closed to begin with: a payload is the only
                                           cell tall enough to push the row about the event off its own
                                           line, and a history is read by running down the positions and
                                           the types first. A <details> rather than script, like the
                                           rows on the events page, because these pages render
                                           statically. *@
                                        <details class="payload" open="@PayloadsOpen">
                                            @* How much is under it, so a closed row still says whether
                                               opening it is worth it. What it holds is the pairs'
                                               to say. *@
                                            <summary>@Held(stored.State.Count)</summary>

                                            @* A list, because that is what it is: one name and value
                                               per item, in the same shape the projection's own state is
                                               read in. The name is set apart from the value it names,
                                               so a cell of several pairs is scanned rather than read
                                               through — and a value with a shape inside it is opened
                                               under its own name. *@
                                            @Pairs(stored.State)
                                        </details>
                                    }
                                </td>
                                @* A mark rather than a word: the column is one link per row and
                                   the word repeats down it. The position it is read out by tells a
                                   row from the one above, which its place alone would not.

                                   Offered on every row, including the two the column beside it has
                                   nothing to show for: a payload that will not read back and a type
                                   nothing uploaded describes are exactly the rows whose text is
                                   worth looking at. *@
                                <td class="marked">
                                    <a class="icon-link" href="@JsonLink(stored.Position)"
                                       aria-label="View the stored JSON at position @stored.Position"
                                       title="View the stored JSON at position @stored.Position">
                                        <JsonMark/>
                                    </a>
                                </td>
                                @* The two versions the link compares, which is what tells the link
                                   on one row from the link on the next: the version this event
                                   produced, and the one before it. Versions rather than positions,
                                   because they climb by one down the projection's history where the
                                   position counts the whole log. Offered on every row: a payload
                                   that will not read back is exactly the event whose effect is
                                   worth seeing, and the fold either applies it or says why it
                                   could not. *@
                                <td>
                                    @if (Events.Versions.TryGetValue(stored.Position, out var version))
                                    {
                                        <a class="button-mark quiet" href="@CompareLink(version)"
                                           aria-label="Compare version @(version - 1) with version @version"
                                           title="Compare version @(version - 1) with version @version">
                                            @(version - 1) → @version
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="missing">—</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>

                    <div class="table-footer">
                        @* The pages as links, ten at a time. Links rather than a control, like the one
                           on the list: what the page is being read through — the identifier, the tab,
                           the order and the fold — is already in the address, so a link to another page
                           carries all of it without a form having to hold a copy of each. *@
                        <Pager Page="Events.Page" TotalPages="Events.TotalPages"
                               Href="@(page => EventsLink(Descending, page))"/>

                        <form class="page-size" method="get" action="dcb/projections/detail#@EventsAnchor">
                            <label for="size">Rows per page</label>
                            <select id="size" name="size" onchange="this.form.submit()">
                                @foreach (var option in InstanceQuery.PageSizes)
                                {
                                    <option value="@option" selected="@(option == PageSize)">@option</option>
                                }
                            </select>
                            <input type="hidden" name="type" value="@Projection.FullName"/>
                            <input type="hidden" name="id" value="@Identifier.FullName"/>
                            @foreach (var parameter in Parameters)
                            {
                                <input type="hidden" name="@parameter.Name"
                                       value="@Values.GetValueOrDefault(parameter.Name)"/>
                            }
                            <input type="hidden" name="tab" value="@EventsTab"/>
                            <input type="hidden" name="dir" value="@(Descending ? "desc" : "asc")"/>
                            @* The narrowing travels too: how many rows a table is read at is not a
                               reason to widen it back to the whole history. *@
                            @if (Choice.Chosen is { } chosen)
                            {
                                <input type="hidden" name="event" value="@chosen.FullName"/>
                            }
                            @if (IsFiltered)
                            {
                                <input type="hidden" name="text" value="@Text"/>
                            }
                            @if (PayloadsOpen)
                            {
                                <input type="hidden" name="payloads" value="@Open"/>
                            }
                            <noscript>
                                <button type="submit">Apply</button>
                            </noscript>
                        </form>
                    </div>
                }
            }
        </section>
    }

    else if (Tab == CompareTab)
    {
        @* Two folds of the boundary through this row's identifier, laid over each other as one
           table. Drawn by the panel the streamed pages draw the same thing with; what is this
           page's to say is which model, where the form comes back to, what carries the row, and
           that the place a version was folded up to is a position in the one log. *@
        <ComparePanel Unavailable="Unfoldable" Comparison="Comparison" Noun="projection" PointLabel="Position"
                      StoredVersion="Stored?.Version" UpdateHref="@TabLink(UpdateTab)"
                      Action="@($"dcb/projections/detail#tab-{CompareTab}")"
                      Link="@(pair => DetailLink(CompareTab, Descending, Page, from: pair.From, to: pair.To))">
            <Carried>
                <input type="hidden" name="type" value="@Projection?.FullName"/>
                <input type="hidden" name="id" value="@Identifier?.FullName"/>
                @foreach (var parameter in Parameters)
                {
                    <input type="hidden" name="@parameter.Name"
                           value="@Values.GetValueOrDefault(parameter.Name)"/>
                }
                <input type="hidden" name="dir" value="@(Descending ? "desc" : "asc")"/>
                <input type="hidden" name="size" value="@PageSize"/>
                <input type="hidden" name="page" value="@Page"/>
            </Carried>
        </ComparePanel>
    }
    else if (Tab == UpdateTab)
    {
        @* The one write these pages offer, given a tab of its own so the three that read stay
           reading. It is the seam the other three meet at: it takes what the events tab lists and
           writes it into what the info and state tabs show. *@
        <section class="tab-panel" aria-labelledby="tab-@UpdateTab">
            @* Held behind the role the button needs, here rather than on the tab's link: this is a
               page a Reader is already reading, so the tab is better explained than removed. The
               explanation names the role, which is what they have to ask for. *@
            <AuthorizeView Policy="@Roles.Updater" Context="signedIn">
            <NotAuthorized>
                <p class="missing">
                    Updating a snapshot needs the Updater role, which you do not hold. Ask whoever runs
                    this tool to map yours.
                </p>
            </NotAuthorized>
            <Authorized>
            @if (Boundary is null)
            {
                <p class="missing">There is no boundary to refresh a snapshot from.</p>
            }
            else
            {
                @* Above the button rather than beside it: on a tab of its own there is the width to
                   read it as prose, and it says what pressing the button will do, so it comes
                   first. *@
                <p class="lede">
                    Refreshes the stored snapshot: any events on the events tab that it has not
                    applied yet are applied to it and the result is written back. A read model
                    produces no events of its own, so the snapshot is the only thing this writes.
                </p>

                <form method="post" action="dcb/projections/update" class="refresh">
                    <AntiforgeryToken/>
                    <input type="hidden" name="type" value="@Projection.FullName"/>
                    <input type="hidden" name="id" value="@Identifier.FullName"/>
                    @foreach (var parameter in Parameters)
                    {
                        <input type="hidden" name="@parameter.Name" value="@Values.GetValueOrDefault(parameter.Name)"/>
                    }
                    @* Back to this tab, which is where the button was pressed and where the notice
                       saying what it did is written. *@
                    <input type="hidden" name="returnUrl" value="/@TabLink(UpdateTab)"/>
                    <button type="submit" class="button">Update</button>
                </form>

                @* What the last press did, carried back on the address so it survives the redirect.
                   Below the button rather than at the top of the page, so the answer is read where
                   the question was asked. *@
                @if (Message is not null)
                {
                    <p class="notice" role="status">@Message</p>
                }
                else if (RefreshError is not null)
                {
                    <p class="alert" role="alert">@RefreshError</p>
                }
            }
            </Authorized>
            </AuthorizeView>
        </section>
    }

    @* What the row was folded into, opened over whichever tab was being read. Last in the markup
       because it covers the page rather than sitting anywhere in it, and drawn only when the
       address asks for it — so the page underneath is the page a reader left. *@
    @if (ViewedType is { } viewed)
    {
        <TypeDialog Description="viewed"
                    Kind="ModelKind.Projection"
                    Store="ModelStore.Dcb"
                    Tab="@View"
                    TabLink="ViewTypeLink"
                    CloseLink="@TabLink(Tab)"
                    DataLink="TypeDataLink"/>
    }

    @* One event's payload, opened over the tab it was listed on. Drawn only when the address asks
       for a row that is on the page under it, so the table behind it is the table a reader left. *@
    @if (OpenedEvent is { } appended)
    {
        <JsonDialog Title="@DomainTypeDescriber.LabelOfKey(appended.Type)"
                    IdLabel="Position" Id="@appended.Position.ToString()"
                    Data="@appended.Data"
                    CloseLink="@EventsLink(Descending, Events.Page)"/>
    }
}

@code {

    /// <summary>
    /// Which of the two DCB models this page reads, which is what tells the store's one snapshot
    /// table which of its rows are this page's.
    /// </summary>
    private const DcbModelKind Kind = DcbModelKind.Projection;

    private Type? Projection { get; set; }

    private Type? Identifier { get; set; }

    private IReadOnlyList<IdentifierParameter> Parameters { get; set; } = [];

    private Dictionary<string, string?> Values { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// What this page is a view of: the events the identifier's values resolve to. Held as the
    /// query rather than as the string it renders to, because the header says how its tags combine
    /// and the canonical form spells that with a comma or an ampersand and is not meant to be read
    /// back.
    /// </summary>
    private TagQuery? Boundary { get; set; }

    /// <summary>
    /// The boundary as the line above the tabs shows it: its tags listed one way whichever way they
    /// combine, and the word that tells the two apart beside them.
    /// </summary>
    /// <remarks>
    /// Read off the canonical form through the same type the data pages read a stored boundary
    /// with, so a boundary met here and met as a stored row's are one rendering rather than two
    /// that drift — down to the space after the comma, which the canonical form does not have
    /// because it is a key rather than a line to read.
    /// </remarks>
    private StoredBoundary? Tags =>
        Boundary is null ? null : StoredBoundary.Read(Boundary.ToString());

    private StoredSnapshot? Stored { get; set; }

    private object? Loaded { get; set; }

    private string? Error { get; set; }

    private IReadOnlyList<DomainPropertyValue> State { get; set; } = [];

    private StoredEvents Events { get; set; } = new([], Total: 0, Page: 1, TotalPages: 1, Error: null);

    /// <summary>
    /// The identifier rebuilt from the values in the address, or null when it could not be. Kept
    /// because the compare tab has to say which of the two it was.
    /// </summary>
    private object? Instance { get; set; }

    /// <summary>
    /// The compare tab's two folds, or why there are none. Nothing until that tab asks for it.
    /// </summary>
    private ModelComparison Comparison { get; set; } = ModelComparison.None;

    /// <summary>
    /// Why the store cannot be asked to fold this row, for the compare tab to draw in place of its
    /// form — or null when it can.
    /// </summary>
    /// <remarks>
    /// The store folds a model through its identifier, whose boundary selects its events, so the
    /// identifier has to be rebuilt from the address before it can be asked — and rebuilt as the
    /// kind of identifier this page is about.
    /// </remarks>
    private RenderFragment? Unfoldable
    {
        get
        {
            if (Instance is null)
            {
                return @<p class="missing">
            The identifier could not be rebuilt from this address, so there is nothing to say what
            to fold.
        </p>;
            }

            if (Instance is not IDcbProjectionId)
            {
                return @<p class="missing">
            <code>@Identifier?.Name</code> does not name a DCB projection, so there is nothing to say
            what to fold.
        </p>;
            }

            return null;
        }
    }

    /// <summary>
    /// How far the stored version has fallen behind the events the projection applies, or null when
    /// it has not, when there is no row to say it of, or when the history could not be counted.
    /// </summary>
    /// <remarks>
    /// Worked out for the info tab alone, which is the only tab with anywhere to say it: the others
    /// are a fold of the same row, the text it was written from, and the history itself, and a count
    /// read for them would be a round trip spent on something none of them draws.
    /// </remarks>
    private SnapshotLag? Lag { get; set; }

    /// <summary>
    /// The event types this projection applies, or null when it applies everything inside its
    /// boundary. What the store selects the history on, and what the dropdown above the table offers.
    /// </summary>
    private Type[]? Applies { get; set; }

    /// <summary>
    /// The types the dropdown offers, which is what a name in the address is matched against.
    /// </summary>
    /// <remarks>
    /// What the projection applies, because that is what its history is made of: offering a type it
    /// folds none of would be a choice narrowing to an empty table every time. A projection that
    /// applies everything has no such list of its own, so it offers every registered DCB event —
    /// the same list the log's own page offers, and the widest thing its boundary could hold.
    /// </remarks>
    private IReadOnlyList<Type> EventTypes => Applies ?? Types.Current.DcbEvents;

    /// <summary>
    /// Which of the history's events are being looked at: all of them, one type, or neither because
    /// the name in the address reaches nothing this projection applies.
    /// </summary>
    private TypeChoice Choice { get; set; } = new(Chosen: null, Unknown: false);

    /// <summary>
    /// The text a row's payload has to carry, or null when the history is read whole.
    /// </summary>
    private string? Text { get; set; }

    private bool IsFiltered => !string.IsNullOrWhiteSpace(Text);

    /// <summary>
    /// Whether the table is narrowed at all, either way. What tells an empty table apart from an
    /// empty history — and what says whether there is anything for a Clear link to undo.
    /// </summary>
    private bool IsNarrowed => !Choice.IsAll || IsFiltered;

    /// <summary>
    /// A boundary reads as a history, so it starts at the beginning until the column is clicked.
    /// The list of projections starts newest first instead, because a list is scanned rather than
    /// read through.
    /// </summary>
    private bool Descending { get; set; }

    private int PageSize { get; set; } = InstanceQuery.DefaultPageSize;

    /// <summary>
    /// The page the address asks for, which the events tab may not have read — kept apart from
    /// <see cref="StoredEvents.Page"/>, the page actually landed on once the total is known.
    /// </summary>
    private int Page { get; set; } = 1;

    /// <summary>
    /// Whether every payload on the events tab starts open. Closed unless the address says
    /// otherwise: a history is read by running down the positions and the types, and the payloads
    /// are what is opened once something on a row is worth following.
    /// </summary>
    /// <remarks>
    /// The state of the table rather than of any row. A reader still folds one row at a time, and
    /// this only says what they are all folded to on arrival — which is why it travels through
    /// <see cref="DetailLink"/> with everything else: paging, re-ordering or leaving the tab and
    /// coming back with the payloads out should not quietly shut them.
    /// </remarks>
    private bool PayloadsOpen { get; set; }

    /// <summary>What the address says when the payloads are out.</summary>
    private const string Open = "open";

    /// <summary>
    /// How much a folded payload has under it, so a closed row still says whether opening it is
    /// worth it. The properties it declares, not the ones nested inside them: the count belongs to
    /// what the fold hides at its first line.
    /// </summary>
    private static string Held(int values) => values == 1 ? "1 value" : $"{values} values";

    /// <summary>
    /// The five views the page offers, named as they appear in the address. Which one is showing
    /// is the address's to say, so a view can be linked to, bookmarked, and gone back to.
    /// </summary>
    private const string InfoTab = "info";

    private const string StateTab = "state";

    private const string JsonTab = "json";

    private const string EventsTab = "events";

    private const string UpdateTab = "update";

    private const string CompareTab = ComparePanel.Tab;

    private string Tab { get; set; } = InfoTab;

    /// <summary>How far the table is narrowed to one type, in the words the count is counted in.</summary>
    private string Of => Choice.IsAll ? string.Empty : $" of {Choice.Name}";

    /// <summary>
    /// How many events there are in all.
    /// </summary>
    /// <remarks>
    /// Whose they are is not said. The heading, the tags and the tab above have already answered
    /// that three times over, and the count is on this page rather than on the log's because of
    /// them — so it is left to say the one thing that is its own to say.
    /// <para>
    /// A table narrowed by what a row carries counts what matched, which is not the same claim about
    /// what the projection is folded from. Said the way the log's own page says it, so a count means
    /// one thing across the two.
    /// </para>
    /// </remarks>
    private string EventSummary => (Events.Total, IsFiltered) switch
    {
        (1, false) => $"One event{Of}.",
        (_, false) => $"{Events.Total} events{Of}.",
        (1, true) => $"One matching event{Of}.",
        (_, true) => $"{Events.Total} matching events{Of}."
    };

    /// <summary>
    /// What the last refresh did. Named apart from <see cref="Error"/>, which is the store failing
    /// to answer for the projection at all rather than a button failing to do its job.
    /// </summary>
    [SupplyParameterFromQuery(Name = "message")]
    private string? Message { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? RefreshError { get; set; }

    /// <summary>
    /// The anchor the events panel starts at, so paging and re-ordering land on the rows that
    /// changed rather than at the top of a page whose first screen did not.
    /// </summary>
    private const string EventsAnchor = "events";

    /// <summary>
    /// Everything that addresses the projection itself: the two types and the values that identify
    /// the instance. The view and the table's own state are appended by whatever varies them.
    /// </summary>
    private string Address =>
        $"dcb/projections/detail?type={Uri.EscapeDataString(Projection?.FullName ?? string.Empty)}" +
        $"&id={Uri.EscapeDataString(Identifier?.FullName ?? string.Empty)}" +
        string.Concat(Parameters.Select(parameter =>
            $"&{Uri.EscapeDataString(parameter.Name)}=" +
            $"{Uri.EscapeDataString(Values.GetValueOrDefault(parameter.Name) ?? string.Empty)}"));

    /// <summary>
    /// One address for the whole page, carrying everything that addresses the projection as well as
    /// the state of the events table, so a link only changes what it means to change.
    /// </summary>
    /// <param name="tab">Which of the five views to show.</param>
    /// <param name="descending">Whether the newest events come first.</param>
    /// <param name="page">The events page to land on, from one.</param>
    /// <param name="toTable">
    /// Whether to land at the events panel. False for a tab and for the refresh, which changes the
    /// version and the state and says so in a notice at the top — the navigations that want the top.
    /// </param>
    /// <param name="open">Whether the payloads are out, or null to carry on as they are.</param>
    /// <param name="clearEvent">Whether to widen back to every type the projection applies.</param>
    /// <param name="clearText">Whether to drop the text a row had to carry.</param>
    /// <remarks>
    /// The payloads and the two narrowings are named only when they are made. Folded and unnarrowed
    /// are what the table opens as, so a link to one is a link with nothing to say about them.
    /// <para>
    /// The narrowings travel with every link here for the same reason the order and the fold do:
    /// paging, re-ordering or leaving the tab and coming back should not quietly widen a table back
    /// to a history the reader had narrowed away.
    /// </para>
    /// </remarks>
    private string DetailLink(
        string tab,
        bool descending,
        int page,
        bool toTable = false,
        bool? open = null,
        bool clearEvent = false,
        bool clearText = false,
        string? view = null,
        string? json = null,
        long? from = null,
        long? to = null) =>
        $"{Address}&tab={tab}" +
        $"&dir={(descending ? "desc" : "asc")}" +
        $"&size={PageSize}" +
        $"&page={page}" +
        ((open ?? PayloadsOpen) ? $"&payloads={Open}" : string.Empty) +
        (!clearEvent && Choice.Chosen is { } chosen
            ? $"&event={Uri.EscapeDataString(chosen.FullName ?? chosen.Name)}"
            : string.Empty) +
        (!clearText && IsFiltered ? $"&text={Uri.EscapeDataString(Text!)}" : string.Empty) +
        (view is { Length: > 0 } ? $"&view={view}" : string.Empty) +
        (json is { Length: > 0 } ? $"&json={Uri.EscapeDataString(json)}" : string.Empty) +
        // The pair the compare tab folds, named only by a link to that tab: the others have
        // nothing to fold, and carrying a pair along would leave it in the address of a view that
        // does not read it.
        (from is { } earlier ? $"&from={earlier}" : string.Empty) +
        (to is { } later ? $"&to={later}" : string.Empty) +
        // Last, because everything after a fragment is part of it.
        (toTable ? $"#{EventsAnchor}" : string.Empty);

    /// <summary>
    /// Which view of the declared type is open over the page, or nothing when none is.
    /// </summary>
    /// <remarks>
    /// Named only when it is open, which is what makes every other link on the page close it: a
    /// reader who moves the page underneath has left the type behind, and carrying it along would
    /// leave a panel hanging over a row it is no longer about.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "view")]
    private string? RequestedView { get; set; }

    /// <summary>Which of the type's four views to show once it is open.</summary>
    private string View => TypeView.Match(RequestedView);

    /// <summary>
    /// The type this row was folded into, described, or null when the address is not asking for it.
    /// Described only when it is asked for: it walks the type's whole shape, and a page reading one
    /// stored row has no other use for it.
    /// </summary>
    private DomainTypeDescription? ViewedType =>
        !string.IsNullOrWhiteSpace(RequestedView) && Projection is { } projection
            ? DomainTypeDescriber.Describe(projection, Types.Current.DcbProjectionIds)
            : null;

    /// <summary>
    /// Which event's payload is open over the page, or null when none is.
    /// </summary>
    /// <remarks>
    /// Named only when it is open, which is what makes every other link on the page close it: a
    /// reader who changes tab, pages or narrows has left that row behind, and carrying it along
    /// would leave a payload hanging over a table it is no longer in.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "json")]
    private string? RequestedJson { get; set; }

    /// <summary>
    /// The row it names, or null when the address names none or names one that is not on this page.
    /// </summary>
    /// <remarks>
    /// Found among the rows already read rather than fetched on its own: the pop-up opens over the
    /// page it was opened from, so the row is one of the ones drawn underneath it. A key that is not
    /// there costs nothing and shows nothing, which is what a stale link should do.
    /// </remarks>
    private StoredEvent? OpenedEvent =>
        long.TryParse(RequestedJson, out var position)
            ? Events.Events.FirstOrDefault(row => row.Position == position)
            : null;

    /// <summary>
    /// The events tab as it stands with one row's payload open over it, landing on the panel so a
    /// reader far down the table is taken to what they just opened.
    /// </summary>
    private string JsonLink(long position) =>
        DetailLink(EventsTab, Descending, Events.Page, json: position.ToString()) +
        $"#{JsonDialog.Anchor}";

    /// <summary>
    /// The page as it stands with one of the type's views open over it, landing on the panel so a
    /// reader who was far down the events table is taken to what they just opened.
    /// </summary>
    private string ViewTypeLink(string view) =>
        DetailLink(Tab, Descending, Page, view: view) + $"#{TypeDialog.Anchor}";

    /// <summary>
    /// Out to every row one identifier addresses, from the panel's identifiers tab. The type is this
    /// page's own; only the identifier varies, which is what the column is one link per row for.
    /// </summary>
    private string TypeDataLink(Type identifier) =>
        $"dcb/projections/data?type={Uri.EscapeDataString(Projection?.FullName ?? string.Empty)}" +
        $"&id={Uri.EscapeDataString(identifier.FullName ?? identifier.Name)}";

    /// <summary>
    /// A tab, keeping the events table where it was left, so leaving the events tab and coming back
    /// returns to the page and order it was read at rather than to the first one.
    /// </summary>
    private string TabLink(string tab) => DetailLink(tab, Descending, Page);

    /// <summary>
    /// The compare tab with the version an event produced held against the one before it: what
    /// that one event did to the projection.
    /// </summary>
    /// <remarks>
    /// Before the first version is zero, and version zero is the projection before anything happened
    /// to it — the store hands back a fresh one — so the first row compares against that rather
    /// than needing a link of its own.
    /// </remarks>
    private string CompareLink(int version) =>
        DetailLink(CompareTab, Descending, Events.Page, from: version - 1, to: version);

    private string EventsLink(bool descending, int page, bool toTable = true) =>
        DetailLink(EventsTab, descending, page, toTable);

    /// <summary>
    /// The table as it stands, with the payloads turned the other way. It stays on the page the
    /// reader is on: this changes how the rows are looked at, not which of them are.
    /// </summary>
    private string FoldLink =>
        DetailLink(EventsTab, Descending, Events.Page, toTable: true, open: !PayloadsOpen);

    /// <summary>
    /// One way back to the whole history, because that is the one thing a reader wants from here:
    /// dropping the type but keeping the text would be a second narrowing to undo. Back to the first
    /// page too, since the page they were on was a page of the narrowed table.
    /// </summary>
    private string ClearLink =>
        DetailLink(EventsTab, Descending, page: 1, toTable: true, clearEvent: true, clearText: true);

    /// <summary>
    /// What the page is, for the heading and the title. Unlike the pages that list, this one is
    /// about one stored model, so the heading is the name of that model rather than the name of a
    /// section — and the bare word when the address names nothing that is registered.
    /// </summary>
    private string Heading =>
        Projection is null ? "Projection" : DomainTypeDescriber.LabelOf(Projection);

    private string Title => string.Join(" · ",
        Parameters.Select(parameter => Values.GetValueOrDefault(parameter.Name))
            .Where(value => !string.IsNullOrWhiteSpace(value)));

    private string BackToList =>
        $"dcb/projections/data?type={Uri.EscapeDataString(Projection?.FullName ?? string.Empty)}" +
        $"&id={Uri.EscapeDataString(Identifier?.FullName ?? string.Empty)}";

    /// <summary>
    /// What the stored model holds, a row each, with the insides of any value one holds in rows
    /// under it.
    /// </summary>
    /// <remarks>
    /// The same rows the projections page lists the type's shape in, with the column this page has
    /// something to put in. A nested property keeps its own row so that its value stays under the
    /// value column, which is the column a reader came to this page for.
    /// </remarks>
    private RenderFragment<(IReadOnlyList<DomainPropertyValue> Properties, int Depth)> StateRows =>
        rows =>
        @<text>
            @foreach (var property in rows.Properties)
            {
                <tr class="@Under(rows.Depth)">
                    <td>@property.Name</td>
                    <td><code>@property.TypeName</code></td>
                    @* A value holding a shape has nothing of its own to show — what it holds is on
                       the rows below — so the cell is left as empty rather than as unread. *@
                    <td>@(property.Value ?? (property.Children.Count > 0 ? string.Empty : "—"))</td>
                </tr>

                @if (property.Children.Count > 0)
                {
                    @StateRows((property.Children, rows.Depth + 1))
                }
            }
        </text>;

    /// <summary>
    /// What one event carries, as the pairs it is made of, with a value that has a shape inside it
    /// opened under the name that holds it.
    /// </summary>
    /// <remarks>
    /// Draws itself, because a payload nests as deep as the describer read it. Inside a cell rather
    /// than as rows, unlike <see cref="StateRows"/>: here the whole payload is one column of a row
    /// about the event, so there are no columns of its own to keep anything lined up with.
    /// <para>
    /// Names and values both mark what the filter was typed against: the store matched the payload
    /// as it was written, and a name is in that text as much as a value is.
    /// </para>
    /// </remarks>
    private RenderFragment<IReadOnlyList<DomainPropertyValue>> Pairs => properties =>
        @<ul class="pairs">
            @foreach (var property in properties)
            {
                <li>
                    <span class="pair-name"><Highlighted Text="@property.Name" Needle="@Text"/></span>

                    @if (property.Children.Count == 0)
                    {
                        <span class="pair-value">
                            @if (property.Value is null)
                            {
                                <text>—</text>
                            }
                            else
                            {
                                <Highlighted Text="@property.Value" Needle="@Text"/>
                            }
                        </span>
                    }
                    else
                    {
                        @* How many there are, when it is a list. A single shape says nothing here
                           that the pairs under it do not say better. *@
                        @if (property.Value is not null)
                        {
                            <span class="pair-value"><Highlighted Text="@property.Value" Needle="@Text"/></span>
                        }

                        @Pairs(property.Children)
                    }
                </li>
            }
        </ul>;

    /// <summary>
    /// How far under something a row sits, as a class rather than a measurement, so how wide a step
    /// is stays the stylesheet's to say. A row at the top is not under anything and carries none.
    /// </summary>
    private static string? Under(int depth) => depth == 0 ? null : $"under-{Math.Min(depth, 3)}";

    protected override async Task OnParametersSetAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);

        Values = query.ToDictionary(
            pair => pair.Key, pair => (string?)pair.Value.LastOrDefault(),
            StringComparer.OrdinalIgnoreCase);

        // Matched against the six the page has, so an unknown name in the address opens the one
        // it opens with rather than a blank page.
        Tab = (Values.GetValueOrDefault("tab") ?? string.Empty).ToLowerInvariant() switch
        {
            StateTab => StateTab,
            JsonTab => JsonTab,
            EventsTab => EventsTab,
            CompareTab => CompareTab,
            UpdateTab => UpdateTab,
            _ => InfoTab,
        };

        // Both are matched against what is registered, so a name in the address can only ever reach
        // a type this application already knows about.
        Projection = DomainTypeDescriber.Select(Types.Current.DcbProjections, Values.GetValueOrDefault("type"));

        Identifier = Projection is null
            ? null
            : DomainTypeDescriber
                .Describe(Projection, Types.Current.DcbProjectionIds)
                .Identifiers
                .FirstOrDefault(identifier => identifier.FullName == Values.GetValueOrDefault("id"));

        if (Projection is null || Identifier is null)
        {
            return;
        }

        Parameters = IdentifierFactory.Parameters(Identifier);

        var created = IdentifierFactory.Create(Identifier, Values);

        Instance = created.Instance;

        if (created.Instance is null)
        {
            Error = created.Error;
            return;
        }

        if (created.Instance is not IDcbProjectionId projectionId)
        {
            return;
        }

        // The boundary is the projection's own account of which events it was folded from, and it
        // addresses both reads below: the snapshot row it produced, which is only ever a valid
        // answer for the boundary that produced it, and the events it selects.
        Boundary = projectionId.Boundary;

        var loaded = await ModelReader.Load(
            StoreContext, Projection, Kind, Kind.BindingKey(Projection), Boundary.ToString());

        Loaded = loaded.Model;
        Stored = loaded.Snapshot;
        Error = loaded.Error;
        State = Loaded is null ? [] : DomainTypeDescriber.ReadState(Loaded);

        // Read once, because two things want it: the store, which selects the history on it, and the
        // dropdown above the table, which offers those same types to narrow that history by.
        Applies = BoundaryEvents.AppliedBy(Projection, Loaded);

        Descending = string.Equals(Values.GetValueOrDefault("dir"), "desc", StringComparison.OrdinalIgnoreCase);
        PageSize = InstanceQuery.PageSizeOf(Values.GetValueOrDefault("size"));
        Page = int.TryParse(Values.GetValueOrDefault("page"), out var asked) ? asked : 1;
        PayloadsOpen = string.Equals(
            Values.GetValueOrDefault("payloads"), Open, StringComparison.OrdinalIgnoreCase);

        // The info tab reports no counts either, but it does report the version, and a version only
        // means something against the history behind it — so the one thing asked for here is how
        // many events there are. A page of one, because the rows themselves are the events tab's;
        // the total is the whole count whatever page is asked for, which is what is wanted.
        if (Tab == InfoTab && Stored is not null)
        {
            var history = await BoundaryEvents.Load(
                StoreContext,
                projectionId.Boundary,
                Applies,
                eventType: null,
                text: null,
                descending: false,
                page: 1,
                size: 1);

            // A count that failed says nothing rather than nothing found: a boundary the store could
            // not read is not a boundary holding no events, and either would leave the warning
            // undrawn — but only one of them would be honest about it.
            Lag = SnapshotLag.Of(Stored.Version, history.Error is null ? history.Total : null);
        }

        // Two folds of the boundary, read only for the tab that draws them: the whole history the
        // events tab pages, handed over whole so the versions are counted and placed over it.
        if (Tab == CompareTab)
        {
            Comparison = await BoundaryComparison.Of(
                await BoundaryEvents.History(StoreContext, projectionId.Boundary, Applies),
                Folds,
                new BoundaryComparisonRequest(
                    Projection, projectionId,
                    Values.GetValueOrDefault("from"), Values.GetValueOrDefault("to")));
        }

        // Only when they are the view being shown. The tab labels report no counts, so nothing on
        // the other tabs needs the events read, and reading them anyway would cost the state and
        // json tabs a count and a page of rows each to render nothing from.
        if (Tab == EventsTab)
        {
            // A name in the address is matched against what the projection applies, so it can only
            // ever reach a type this history could hold.
            Choice = TypeChoice.Of(EventTypes, Values.GetValueOrDefault("event"));
            Text = Values.GetValueOrDefault("text");

            // A choice with nothing to look for is not asked about. Its key is null, and null
            // narrows to everything rather than to nothing — so asking would answer the name of one
            // type with the whole history.
            Events = Choice.ShowsNothing
                ? new StoredEvents([], Total: 0, Page: 1, TotalPages: 1, Error: null)
                : await BoundaryEvents.Load(
                    StoreContext,
                    projectionId.Boundary,
                    Applies,
                    Choice.Key,
                    Text,
                    Descending,
                    Page,
                    PageSize);
        }
    }

}
