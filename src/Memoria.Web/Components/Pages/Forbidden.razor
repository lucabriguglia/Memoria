@page "/forbidden"
@layout MainLayout

@* Where a signed-in operator lands when an address needs a role they do not hold. Says the things
   they can act on — who the tool thinks they are, which role the address wanted, which service it
   was under, and which address — because the fix is somebody else's: whoever maps the provider's
   groups to the tool's roles, or whoever writes that service's manifest, and the operator has to
   tell them all of it. *@

<PageTitle>Not allowed</PageTitle>

<h1>Not allowed</h1>

<AuthorizeView>
    <Authorized>
        <p>
            You are signed in as <strong>@context.User.Identity?.Name</strong>, and
            <code>@ReturnUrl</code> needs the <strong>@Role</strong> role
            @if (Service is { Length: > 0 })
            {
                <text>for the service <strong>@Service</strong></text>
            }
            , which you do not hold.
        </p>
    </Authorized>
</AuthorizeView>

@if (Service is { Length: > 0 })
{
    <p>
        A role is granted for one service by that service's manifest naming a claim your sign-in
        carries, or for every service by the tool's configuration mapping one. Ask whoever runs
        <strong>@Service</strong>, or whoever runs this tool, to name yours — or go
        <a href="">back to the home page</a>.
    </p>
}
else
{
    <p>
        Roles are granted by mapping a claim your sign-in carries to the tool's roles in its
        configuration. Ask whoever runs this tool to map yours, or go <a href="">back to the home page</a>.
    </p>
}

@code {

    /// <summary>The role the address needed, as the redirect said.</summary>
    [SupplyParameterFromQuery(Name = "role")]
    public string? Role { get; set; }

    /// <summary>The service the address was under, as the redirect said; null outside every service.</summary>
    [SupplyParameterFromQuery(Name = "service")]
    public string? Service { get; set; }

    /// <summary>Where the operator was going, as the redirect said.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

}
