@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject Memoria.Web.Data.StoreCapabilities Store

<header>
    @* The project's own mark, the same artwork the tab icon is cut from. An <img> rather than the
       inline SVG that used to stand here: this is a painted illustration with gradients on every
       face, not a shape a token could recolour, so there is nothing for it to follow. It carries
       its own colour in both themes — the cubes are saturated enough to hold against the light
       ground and the dark one alike, which is why no second file is shipped for dark.

       alt="" because the link says Memoria beside it, and a screen reader naming the mark as well
       would say it twice. *@
    <a class="brand" href="">
        <img class="mark" src="@Assets["logo.png"]" alt=""/>
        Memoria
    </a>
    <nav>
        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>

        @* <details> rather than a hover menu: it opens on touch and on the keyboard with no
           script, which matters because these pages render statically. *@
        @* Each of the three concerns is a heading over the pages that hold it rather than a link
           of its own: its own overview, the types the model declares, and what has been stored of
           them. The heading names the group without going anywhere — the overview under it is the
           page the heading would have led to, and it is listed with the other two so the whole
           group is reached the same way. Every link matches exactly, so the one you are on is the
           only one marked. *@
        <details class="menu">
            <summary class="@(InSection("streamed") ? "active" : null)">Streamed</summary>
            <div class="submenu">
                <NavLink href="streamed" Match="NavLinkMatch.All">Overview</NavLink>

                <div class="submenu-group">
                    <span class="submenu-label">Events</span>
                    <NavLink href="streamed/events" Match="NavLinkMatch.All">Overview</NavLink>
                    <NavLink href="streamed/events/types" Match="NavLinkMatch.All">Types</NavLink>
                    <NavLink href="streamed/events/data" Match="NavLinkMatch.All">Data</NavLink>
                </div>

                <div class="submenu-group">
                    <span class="submenu-label">Aggregates</span>
                    <NavLink href="streamed/aggregates" Match="NavLinkMatch.All">Overview</NavLink>
                    <NavLink href="streamed/aggregates/types" Match="NavLinkMatch.All">Types</NavLink>
                    <NavLink href="streamed/aggregates/data" Match="NavLinkMatch.All">Data</NavLink>
                </div>

                <div class="submenu-group">
                    <span class="submenu-label">Projections</span>
                    <NavLink href="streamed/projections" Match="NavLinkMatch.All">Overview</NavLink>
                    <NavLink href="streamed/projections/types" Match="NavLinkMatch.All">Types</NavLink>
                    <NavLink href="streamed/projections/data" Match="NavLinkMatch.All">Data</NavLink>
                </div>

                @* One link rather than a group: a stream is declared and nothing else, so there is
                   no pair of pages to choose between. It follows the three because it is the one
                   thing here the DCB menu beside it has no answer to. *@
                <NavLink href="streamed/streams" Match="NavLinkMatch.All">Streams</NavLink>
            </div>
        </details>

@* Only where there is a store holding one. A Cosmos store has no dynamic consistency boundary at
   all, so these would be nine links to pages with nothing to read — the menu is left out rather than
   shown leading nowhere. The pages themselves are not found under such a store either; see
   Routes.razor, which is what makes a bookmarked address agree with this menu. *@
@if (Store.HasDcb)
{
        <details class="menu">
            <summary class="@(InSection("dcb") ? "active" : null)">DCB</summary>
            <div class="submenu">
                <NavLink href="dcb" Match="NavLinkMatch.All">Overview</NavLink>

                <div class="submenu-group">
                    <span class="submenu-label">Events</span>
                    <NavLink href="dcb/events" Match="NavLinkMatch.All">Overview</NavLink>
                    <NavLink href="dcb/events/types" Match="NavLinkMatch.All">Types</NavLink>
                    <NavLink href="dcb/events/data" Match="NavLinkMatch.All">Data</NavLink>
                </div>

                <div class="submenu-group">
                    <span class="submenu-label">Aggregates</span>
                    <NavLink href="dcb/aggregates" Match="NavLinkMatch.All">Overview</NavLink>
                    <NavLink href="dcb/aggregates/types" Match="NavLinkMatch.All">Types</NavLink>
                    <NavLink href="dcb/aggregates/data" Match="NavLinkMatch.All">Data</NavLink>
                </div>

                <div class="submenu-group">
                    <span class="submenu-label">Projections</span>
                    <NavLink href="dcb/projections" Match="NavLinkMatch.All">Overview</NavLink>
                    <NavLink href="dcb/projections/types" Match="NavLinkMatch.All">Types</NavLink>
                    <NavLink href="dcb/projections/data" Match="NavLinkMatch.All">Data</NavLink>
                </div>
            </div>
        </details>
}

        @* The theme is picked under Settings rather than up here: it is this browser's own
           preference, which is what that tab holds, and the bar is for places to go. *@
        <NavLink href="settings">Settings</NavLink>
    </nav>

    @* Who the tool thinks is asking, and the way to stop being them. At the far end of the bar,
       away from the places to go: this is not one of them. Shown only to someone signed in — open,
       there is nobody, and the bar ends with the menu as it always did. A form rather than a link,
       like every other write the pages send: ending a session is one, and it carries the same token
       the others do so a page elsewhere cannot end it on an operator's behalf. *@
    <AuthorizeView>
        <Authorized>
            <div class="operator">
                <span class="operator-name">@context.User.Identity?.Name</span>
                <form method="post" action="logout">
                    <AntiforgeryToken/>
                    <button type="submit" class="quiet">Sign out</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

<main>
    @Body
</main>

<footer>
    <div class="footer-left">
        <span class="copyright">&copy; @DateTime.UtcNow.Year Luca Briguglia</span>
        @* Down here rather than in the bar: the bar is for the store and the tool's own settings,
           and this is the page about the tool — the version, the licence, the documentation —
           which is what a footer is read for. It sits beside the copyright because that is the
           one line of it already written here. *@
        <span class="footer-separator" aria-hidden="true">&middot;</span>
        <a class="footer-link" href="about">About</a>
    </div>
    <div class="footer-links">
        <a class="footer-link" href="https://github.com/lucabriguglia/Memoria" target="_blank" rel="noopener noreferrer">
            <svg class="footer-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                      fill="currentColor"/>
            </svg>
        </a>
        <a class="footer-link" href="https://www.linkedin.com/in/lucabriguglia" target="_blank" rel="noopener noreferrer">
            <svg class="footer-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
                      fill="currentColor"/>
            </svg>
        </a>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {

    /// <summary>
    /// Marks a menu current while anywhere under its section, so the section you are in is
    /// visible without opening it. The panel itself stays shut until asked for, rather than
    /// sitting over the page.
    /// </summary>
    private bool InSection(string section) => Navigation
        .ToBaseRelativePath(Navigation.Uri)
        .StartsWith(section, StringComparison.OrdinalIgnoreCase);

}
