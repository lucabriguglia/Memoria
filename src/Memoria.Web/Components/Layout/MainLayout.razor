<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {

    /// <summary>
    /// Which models the bar is laid out for: the current service's, read off its own view of the
    /// catalogue each time rather than held, since an upload changes the answer without the
    /// layout being told. A store with no boundary never lays the DCB model out, so its nine
    /// links are left off rather than shown leading to pages with nothing to read; the pages are
    /// not found under such a store either — see Routes.razor, which is what makes a bookmarked
    /// address agree with this bar.
    /// </summary>
    private ShownModels Shown => ShownModels.Of(Current.Catalogue, Store);

    /// <summary>An address under the current service: the segment its pages sit under, then the page.</summary>
    private string At(string path) => $"{Current.Segment}/{path}";

    /// <summary>
    /// Marks a menu current while anywhere under its section, so the section you are in is
    /// visible without opening it. The panel itself stays shut until asked for, rather than
    /// sitting over the page. A section is under the current service unless said otherwise —
    /// the operator's own pages are the tool's, and sit under no service.
    /// </summary>
    private bool InSection(string section, bool underService = true) => Navigation
        .ToBaseRelativePath(Navigation.Uri)
        .StartsWith(underService ? At(section) : section, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// One section as a heading of its own on the bar, for when one model is laid out alone: the
    /// same three pages the group under a model heading holds, opened the same way. A template
    /// here rather than a component, so the markup stays in this file and the bar's own styles
    /// reach it.
    /// </summary>
    private RenderFragment Section(string href, string label, SectionKind mark) =>
        @<details class="menu">
            <summary class="@(InSection(href) ? "active" : null)"><SectionMark Kind="@mark"/>@label</summary>
            <div class="submenu">
                <NavLink href="@At(href)" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Overview"/>Overview</NavLink>
                <NavLink href="@At($"{href}/types")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Types"/>Types</NavLink>
                <NavLink href="@At($"{href}/data")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Data"/>Data</NavLink>
            </div>
        </details>;

}
