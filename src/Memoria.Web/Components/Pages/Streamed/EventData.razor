@page "/{service}/streamed/events/data"
@using Memoria.Web.Data
@using Memoria.Web.Extensibility
@using Microsoft.AspNetCore.WebUtilities
@inject CurrentService Current
@inject IStreamedReads Store
@inject NavigationManager Navigation

<PageTitle>Streamed @Heading</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <a href="@Service">@Current.Name</a>
    <span aria-hidden="true">/</span>
    <ModelCrumb Model="ModelStore.Streamed"/>
    <a href="@Service/streamed/events">Events</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Data</span>
</nav>

<h1>@Heading</h1>

@if (Choice.Unknown)
{
    <p class="alert" role="alert">
        That event is not among the registered types. It may have been replaced by a later upload —
        start again from <a href="@Service/streamed/events/types">events</a>.
    </p>
}
else if (Stream.Unknown)
{
    <p class="alert" role="alert">
        That stream is not among the registered types. It may have been replaced by a later upload —
        start again from <a href="@Service/streamed/streams">streams</a>.
    </p>
}
else
{
    @* The whole count, not this page's worth: the pager says which page, and what a reader wants
       beside it is how much there is to page through.

       Under the title and outside the card, because it is the page saying what it found rather than
       part of the table it found it in — and because the filter row below has to sit against the
       table for the two to read as one object. HasRows repeats what the branches below already
       decide; if a branch is added there, add it there too. *@
    @if (HasRows)
    {
        <p class="lede">@Summary</p>
    }

    @* Above the table, because it says what the table holds. Its own GET form, like the pickers
       under the table: the narrowing is a link to a narrower list, so it belongs in the address bar
       where it can be bookmarked, shared and gone back to. The order travels in a hidden field so
       narrowing does not silently reorder; the page deliberately does not, because page four of one
       stream is not page four of another.

       The dropdowns submit on change and the box is typed into, so the button is not only the
       fallback when scripting is off — it submits all three at once, which is what one form buys. *@
    <form class="search" method="get" action="@Service/streamed/events/data">
        @* The stream comes first, as it does in the table: it is where an event was put, and the
           type is what was put there. *@
        <label for="stream">Stream</label>
        <select id="stream" name="stream" onchange="this.form.submit()">
            @* First and default, so a reader who has chosen nothing is looking at the whole log
               rather than at whichever stream happened to be listed first. An empty value, which is
               what the address carries when nothing is narrowed to. *@
            <option value="" selected="@Stream.IsAll">All</option>
            @foreach (var streamId in StreamTypes)
            {
                @* Named by the type, not by the pattern it matches: a reader picks the kind of
                   stream they mean, and customer:% is how the log is asked rather than a thing to
                   choose. *@
                <option value="@streamId.FullName" selected="@(streamId == Stream.Chosen)">
                    @DomainTypeDescriber.OptionLabelOf(streamId)
                </option>
            }
        </select>

        <label for="type">Event type</label>
        <select id="type" name="type" onchange="this.form.submit()">
            <option value="" selected="@Choice.IsAll">All</option>
            @foreach (var @event in EventTypes)
            {
                <option value="@(@event.FullName)" selected="@(@event == Choice.Chosen)">
                    @DomainTypeDescriber.OptionLabelOf(@event)
                </option>
            }
        </select>

        @* Beside the two rather than under them, because all three narrow the same list: a stream
           type is the kind of stream the log put a row in, an event type is what it wrote the row
           under, and this is what the row itself says — its stream, its own id and its payload, any
           of which matching is enough. One box for the three because they are one question: a
           reader typing an order reference means the payload, one typing an id from the first
           column means the stream, one typing an id from the second means that row, and nothing is
           served by making them say which. *@
        <label class="visually-hidden" for="text">Filter by stream, id or payload</label>
        <input id="text" type="search" name="text" value="@Text"
               placeholder="Filter by stream, id or payload" autocomplete="off"/>
        <input type="hidden" name="dir" value="@(Descending ? "desc" : "asc")"/>
        <input type="hidden" name="size" value="@PageSize"/>
        @if (PayloadsOpen)
        {
            <input type="hidden" name="payloads" value="@Open"/>
        }
        <button type="submit" class="quiet">Filter</button>
        @if (!Choice.IsAll || !Stream.IsAll || IsFiltered)
        {
            @* One way back to the whole log, because that is the one thing a reader wants from
               here: dropping one narrowing and keeping the other two would leave them still to
               undo. *@
            <a href="@Link(Descending, 1, clearStream: true, clearType: true, clearText: true)">Clear</a>
        }

        @* Opens or closes every payload on the page at once. A link rather than a control with
           script behind it, like the order and the page beside it: the state lives in the address,
           so a page opened out can be linked to and gone back to, and the rows stay foldable one at
           a time either way. It stays on this page — this is a way of looking at the rows, not a
           way of moving between them.

           Held to the right-hand end of the filter row, with the other controls that act on the
           whole table. It used to have a strip of its own between the filter and the data; once
           the count moved up under the title that strip held nothing else, and a band of empty
           card between the controls and the rows is not worth a row. *@
        <a class="fold-all" href="@Link(Descending, Events.Page, open: !PayloadsOpen)">
            @(PayloadsOpen ? "Collapse all" : "Expand all")
            <span class="arrow @(PayloadsOpen ? "up" : "down")" aria-hidden="true"></span>
        </a>
    </form>

    @* Beside the rows rather than instead of them: the page worked, and this says how well it could
       be ordered. Its own block ahead of the chain below, because every one of those is a reason
       there is no table and this is not — the rows are there and one property of them is weaker.
       Rendered for everyone and taken away afterwards by the browser that was told to: the server
       cannot know what this reader has already read. See wwwroot/preferences.js. *@
    @if (Events.OrderingNotice is not null)
    {
        <div class="caution" role="status" data-notice="ordering">
            <p>@Events.OrderingNotice</p>
            <p class="caution-actions">
                <button type="button" data-notice-close>Close</button>
                <button type="button" data-notice-hide>Don't show this again</button>
            </p>
        </div>
    }

    @if (Choice.Unbound)
    {
        @* Registered, listed, and impossible to have stored: without an [EventType] there is no key
           to write it under. An empty table would say the log holds none of these, which is true
           but not the reason. *@
        <p class="missing">
            It carries no <code>[EventType]</code>, so the log has never written one of these.
        </p>
    }
    else if (Stream.Unshaped)
    {
        @* Registered, listed, and impossible to narrow by. A stream is found in the log by the shape
           of the ids it writes, and that shape is worked out by building one from values that can be
           recognised again — which this stream takes none of. An empty table would say the log holds
           nothing of this stream, which is not what was found out. *@
        <p class="missing">
            Its ids cannot be recognised, so the log cannot be narrowed to it: it is named from a
            value nothing can stand in for.
        </p>
    }
    else if (Events.Error is not null)
    {
        <p class="alert" role="alert">@Events.Error</p>
    }
    else if (Events.Total == 0)
    {
        <p class="empty">
            @* Nothing found and nothing there are two different answers, and what was asked for is
               the difference: an empty log has none of these to match, and a log that holds plenty
               of them has none carrying this, or none of them in this stream. *@
            @if (IsFiltered)
            {
                <text>No stream, id or payload matches &ldquo;@Text&rdquo;.</text>
            }
            else if (Choice.IsAll && Stream.IsAll)
            {
                <text>Nothing has been appended yet.</text>
            }
            else if (Choice.IsAll)
            {
                <text>Nothing has been appended to this stream yet.</text>
            }
            else if (Stream.IsAll)
            {
                <text>Nothing of this type has been appended yet.</text>
            }
            else
            {
                <text>Nothing of this type has been appended to this stream yet.</text>
            }
        </p>
    }
    else
    {
        @* The lede and the fold, at the two ends of the line above the table, in the same shape as
           the pager and the rows-per-page picker at the two ends of the line below it. *@

        @* Where the row went, then what the store filed it as, then what it is. A streamed event is
           appended to a named stream and carries that name, so where it went is the first thing
           about it — and the number after the id is a sequence rather than a position because it
           counts within that stream: every stream has a first event, and two rows numbered 1 are
           two streams rather than one row twice.

           The id is the two of them joined, which is what makes a row unique and what the store
           wrote it under. It says nothing the stream and the sequence beside it do not, and it is
           here because it is the key: this is a page about what the store holds. *@
        <table class="grid events streamed">
            <thead>
            <tr>
                <th scope="col" class="col-stream">Stream</th>
                <th scope="col" class="col-id">Id</th>
                <th scope="col" class="col-sequence">Sequence</th>
                <th scope="col" class="col-appended" aria-sort="@(Descending ? "descending" : "ascending")">
                    @* The only date these have, so the only thing there is to order them by. *@
                    <a href="@Link(!Descending, 1)">
                        Appended
                        <span class="arrow @(Descending ? "down" : "up")" aria-hidden="true"></span>
                    </a>
                </th>
                @* What the log wrote the row under, as one name: the version is part of what a type
                   is called rather than a fact beside it, and it is said only from the second
                   version on — a first is what a name means until a second exists, and a column
                   whose every row ended in v1 would teach its reader to skip it. *@
                <th scope="col" class="col-type">Type</th>
                <th scope="col" class="col-payload">Payload</th>
                @* The same payload as the column before it, and the other question about it: that
                   one opens what the row was read into, this one opens what the store actually
                   wrote. Last, because it is a way to something rather than a value to run an eye
                   down — and narrow, because all it holds is the way in. *@
                <th scope="col" class="col-json marked">Json</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var stored in Events.Events)
            {
                var link = DetailLink(stored);

                @* The whole row is the target, as it is on the lists of stored models: every cell
                   that reads a value carries the same link, and only the first is reachable by
                   keyboard or read out — the rest repeat it. Every row opens, because every row is
                   the store's own: a type nothing uploaded describes is exactly the row worth
                   opening. The two cells that hold a control of their own, the payload's fold and
                   the Json mark, stay as they are — a link laid under them would take the clicks
                   meant for them — and the stylesheet keeps their padding where the row moves the
                   rest onto the anchors. *@
                <tr class="clickable">
                    @* The three places the filter looks — this cell, the next, and the payload —
                       mark what was typed wherever they carry it, so a row says why it was kept. *@
                    <td>
                        <a href="@link"><code><Highlighted Text="@stored.StreamId" Needle="@Text"/></code></a>
                    </td>
                    <td>
                        <a href="@link" tabindex="-1" aria-hidden="true">
                            <code><Highlighted Text="@stored.Id" Needle="@Text"/></code>
                        </a>
                    </td>
                    <td><a href="@link" tabindex="-1" aria-hidden="true">@stored.Event.Position</a></td>
                    <td>
                        <a href="@link" tabindex="-1" aria-hidden="true">
                            @stored.Event.Written.ToLocalTime().ToString("g")
                        </a>
                    </td>
                    @* Name and version as one, the way every list here names a type, so a type met
                       in the log and the same type met on its own page read alike. A key the store
                       wrote that cannot be taken apart is left whole rather than half-read. *@
                    <td>
                        <a href="@link" tabindex="-1" aria-hidden="true">
                            <code>@DomainTypeDescriber.LabelOfKey(stored.Event.Type)</code>
                        </a>
                    </td>
                    <td class="col-payload">
                        @if (stored.Event.Error is not null)
                        {
                            <span class="missing">@stored.Event.Error</span>
                        }
                        else if (stored.Event.State.Count == 0)
                        {
                            <span class="missing">It carries nothing of its own.</span>
                        }
                        else
                        {
                            @* Folded away, and closed to begin with: a payload is the only cell tall
                               enough to push the row about the event off its own line, and a page of
                               the log is read by running down the streams and the types first.
                               A <details> rather than script, like the rows on the events page,
                               because these pages render statically. *@
                            <details class="payload" open="@PayloadsOpen">
                                @* How much is under it, so a closed row still says whether opening
                                   it is worth it. What it holds is the pairs' to say. *@
                                <summary>@Held(stored.Event.State.Count)</summary>

                                @* A list, because that is what it is: one name and value per item.
                                   The name is set apart from the value it names, so a cell of
                                   several pairs is scanned rather than read through — and a value
                                   with a shape inside it is opened under its own name. *@
                                @Pairs(stored.Event.State)
                            </details>
                        }
                    </td>
                    @* A mark rather than a word: the column is one link per row and the word
                       repeats down it. The key it is read out by tells a row from the one above,
                       which its place in the column alone would not.

                       Offered on every row, including the two the column beside it has nothing to
                       show for: a payload that will not read back and a type nothing uploaded
                       describes are exactly the rows whose text is worth looking at. *@
                    <td class="marked">
                        <a class="icon-link" href="@JsonLink(stored.Id)"
                           aria-label="View the stored JSON of @stored.Id"
                           title="View the stored JSON of @stored.Id">
                            <JsonMark/>
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <div class="table-footer">
            @* The pages as links, ten at a time. Links rather than a control, like the order and
               the fold: a page is somewhere to go, and the address it is at is the one this page
               is already read through — so the two narrowings, the order and the fold travel with
               it without a form having to carry a copy of each. *@
            <Pager Page="Events.Page" TotalPages="Events.TotalPages"
                   Href="@(page => Link(Descending, page))"/>

            @* Its own GET form, so the choice lands in the address bar like the order and the type.
               Submitting on change saves a click; the button is the fallback when scripting is off.
               No page travels with it: a page number from a narrower page size would land somewhere
               a reader did not ask for, and the first page is what they can see they are getting. *@
            <form class="page-size" method="get" action="@Service/streamed/events/data">
                <label for="size">Rows per page</label>
                <select id="size" name="size" onchange="this.form.submit()">
                    @foreach (var option in InstanceQuery.PageSizes)
                    {
                        <option value="@option" selected="@(option == PageSize)">@option</option>
                    }
                </select>
                @if (!Stream.IsAll)
                {
                    <input type="hidden" name="stream" value="@Stream.Chosen?.FullName"/>
                }
                @if (!Choice.IsAll)
                {
                    <input type="hidden" name="type" value="@Choice.Chosen?.FullName"/>
                }
                @if (IsFiltered)
                {
                    <input type="hidden" name="text" value="@Text"/>
                }
                <input type="hidden" name="dir" value="@(Descending ? "desc" : "asc")"/>
                @if (PayloadsOpen)
                {
                    <input type="hidden" name="payloads" value="@Open"/>
                }
                <noscript>
                    <button type="submit">Apply</button>
                </noscript>
            </form>
        </div>
    }

    @* One row's payload, opened over the page it was listed on. Last in the markup because it
       covers the page rather than sitting anywhere in it, and drawn only when the address asks for
       a row that is on the page under it — so the table behind it is the table a reader left. *@
    @if (Opened is { } opened)
    {
        <JsonDialog Title="@DomainTypeDescriber.LabelOfKey(opened.Event.Type)"
                    IdLabel="Id" Id="@opened.Id"
                    Data="@opened.Event.Data"
                    CloseLink="@Link(Descending, Events.Page)"/>
    }
}

@code {

    /// <summary>The service this page sits under: the first segment of its address.</summary>
    [Parameter]
    public string Service { get; set; } = string.Empty;

    /// <summary>The request, for the rows-per-page size the browser remembers in a cookie.</summary>
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// Which of the log's events are being looked at: all of them, one type, or neither because the
    /// name in the address reaches nothing that could have been written.
    /// </summary>
    private TypeChoice Choice { get; set; } = new(Chosen: null, Unknown: false);

    /// <summary>
    /// Which kind of stream they are being read out of, or all of them.
    /// </summary>
    private IdChoice Stream { get; set; } = IdChoice.All;

    /// <summary>
    /// The stream types the uploaded assemblies declare, which is what the dropdown offers and what
    /// a name in the address is matched against.
    /// </summary>
    /// <remarks>
    /// The same list the streams page lists. The ids in the log are not the choice on offer: one
    /// type names a stream per value it is given — a customer apiece — so a dropdown of them would
    /// be as long as the log is wide, while the types are few enough to read.
    /// </remarks>
    private IReadOnlyList<Type> StreamTypes => Current.Catalogue.StreamedStreamIds;

    private StoredStreamEvents Events { get; set; } =
        new([], Total: 0, Page: 1, TotalPages: 1, Error: null);

    private bool Descending { get; set; } = true;

    private int PageSize { get; set; } = InstanceQuery.DefaultPageSize;

    /// <summary>
    /// The text a row has to carry, in its stream, its own id or its payload, or null when the log
    /// is read whole.
    /// </summary>
    private string? Text { get; set; }

    private bool IsFiltered => !string.IsNullOrWhiteSpace(Text);

    /// <summary>
    /// Whether every payload on the page starts open. Folded unless the address says otherwise: a
    /// page of the log is read by running down the streams and the types, and the payloads are what
    /// is opened once something on a row is worth following.
    /// </summary>
    /// <remarks>
    /// The state of the page rather than of any row. A reader still folds one row at a time, and
    /// this only says what they are all folded to on arrival — which is why it travels with every
    /// link and every form here: paging or narrowing with the payloads out should not quietly shut
    /// them.
    /// <para>
    /// Filtering does not open them. What was typed is often in a payload, but a reader who narrows
    /// the log has narrowed it to read the rows, and answering with a wall of pairs takes the page
    /// they asked for away from them. The fold above the table is one click when they want it.
    /// </para>
    /// </remarks>
    private bool PayloadsOpen { get; set; }

    /// <summary>What the address says when the payloads are out. Silence is what folds them.</summary>
    private const string Open = "open";

    /// <summary>
    /// How much a folded payload has under it, so a closed row still says whether opening it is
    /// worth it. The properties it declares, not the ones nested inside them: the count belongs to
    /// what the fold hides at its first line.
    /// </summary>
    private static string Held(int values) => values == 1 ? "1 value" : $"{values} values";

    /// <summary>
    /// What the page is, for the heading.
    /// </summary>
    /// <remarks>
    /// The page rather than the choices, and the same however far the log is narrowed. The
    /// dropdowns above the table say what is being looked at and the line under them says how much
    /// of it there is; a heading that changed with them would be a third voice saying the same
    /// thing, and one that moved as the page was narrowed.
    /// </remarks>
    private const string Heading = "Event Data";

    /// <summary>
    /// The events some streamed aggregate or projection applies, which is what the dropdown offers
    /// and what a name in the address is matched against.
    /// </summary>
    /// <remarks>
    /// The same list the streamed events page lists, for the same reason: an event nothing here
    /// folds would be a choice narrowing to rows no streamed model is made of.
    /// </remarks>
    private IReadOnlyList<Type> EventTypes => Current.Catalogue.StreamedEvents;

    /// <summary>
    /// What an event is written into the log as, falling back to the class when it carries no
    /// attribute — the same name the events page lists it under, so one row means one thing across
    /// the two pages.
    /// </summary>
    private static string BoundAs(Type @event) => DomainTypeDescriber.LabelOf(@event);

    /// <summary>How far the table is narrowed to one type, in the words the count is counted in.</summary>
    private string Of => Choice.IsAll ? string.Empty : $", of {Choice.Name}";

    /// <summary>And to one stream, said after it: what was written, then where it went.</summary>
    private string In => Stream.IsAll ? string.Empty : $", in {Stream.Name}";

    /// <summary>
    /// How much there is, and of what.
    /// </summary>
    /// <remarks>
    /// Appended is the whole log's word for it; a filtered table counts what matched, which is not
    /// the same claim about what was written. Said the way the DCB log says it, so a count means
    /// one thing across the two.
    /// </remarks>
    /// <summary>
    /// Whether the page is showing a table at all, and so whether there is a count to put under the
    /// title. Mirrors the branches above the table: anything they answer instead — an unbound
    /// choice, an unshaped stream, an error, or nothing stored — is a page with no rows on it.
    /// </summary>
    private bool HasRows =>
        !Choice.Unbound && !Stream.Unshaped && Events.Error is null && Events.Total > 0;

    private string Summary => (Events.Total, IsFiltered) switch
    {
        (1, false) => $"One event appended{Of}{In}.",
        (_, false) => $"{Events.Total} events appended{Of}{In}.",
        (1, true) => $"One matching event{Of}{In}.",
        (_, true) => $"{Events.Total} matching events{Of}{In}."
    };

    /// <summary>
    /// One address for the whole table state, so a link only changes what it means to change.
    /// </summary>
    /// <param name="descending">Whether the newest come first.</param>
    /// <param name="page">The page to land on, from one.</param>
    /// <param name="clearStream">Whether to widen back to every stream.</param>
    /// <param name="clearType">Whether to widen back to every type.</param>
    /// <param name="clearText">Whether to drop the text a row had to carry.</param>
    /// <param name="open">Whether the payloads are out, or null to carry on as they are.</param>
    /// <remarks>
    /// The three narrowings and the fold are named only when they are made. Folded is what a page
    /// opens as, so a link to a folded one is a link with nothing to say about it.
    /// </remarks>
    private string Link(
        bool descending,
        int page,
        bool clearStream = false,
        bool clearType = false,
        bool clearText = false,
        bool? open = null)
    {
        var link = $"{Service}/streamed/events/data?dir={(descending ? "desc" : "asc")}" +
                   $"&size={PageSize}" +
                   $"&page={page}";

        if (open ?? PayloadsOpen)
        {
            link += $"&payloads={Open}";
        }

        if (!clearStream && Stream.Chosen is { } stream)
        {
            link += $"&stream={Uri.EscapeDataString(stream.FullName ?? stream.Name)}";
        }

        if (!clearType && Choice.Chosen is { } chosen)
        {
            link += $"&type={Uri.EscapeDataString(chosen.FullName ?? chosen.Name)}";
        }

        return clearText || !IsFiltered
            ? link
            : $"{link}&text={Uri.EscapeDataString(Text!)}";
    }

    /// <summary>
    /// Through to one row on its own: the stream it was appended to and the key the store wrote it
    /// under, as the store holds them rather than as the types behind them — a row whose stream
    /// or type no registered type claims still opens, and is the row worth opening.
    /// </summary>
    private string DetailLink(StoredStreamEvent row) =>
        $"{Service}/streamed/events/detail" +
        $"?stream={Uri.EscapeDataString(row.StreamId)}" +
        $"&id={Uri.EscapeDataString(row.Id)}";

    /// <summary>
    /// Which row's payload is open over the page, by the key the store wrote it under, or null when
    /// none is.
    /// </summary>
    /// <remarks>
    /// The key rather than the sequence, because a sequence counts within a stream: this page lists
    /// several streams at once, and two rows on it can share a number.
    /// <para>
    /// Named only when it is open, which is what makes every other link on the page close it: a
    /// reader who pages, re-orders or narrows has left that row behind, and carrying it along would
    /// leave a payload hanging over a table it is no longer in.
    /// </para>
    /// </remarks>
    [SupplyParameterFromQuery(Name = "json")]
    private string? RequestedJson { get; set; }

    /// <summary>
    /// The row that names, or null when the address names none or names one that is not on this
    /// page.
    /// </summary>
    /// <remarks>
    /// Found among the rows already read rather than fetched on its own: the pop-up opens over the
    /// page it was opened from, so the row is one of the ones drawn underneath it. A key that is not
    /// there costs nothing and shows nothing, which is what a stale link should do.
    /// </remarks>
    private StoredStreamEvent? Opened =>
        string.IsNullOrEmpty(RequestedJson)
            ? null
            : Events.Events.FirstOrDefault(row => row.Id == RequestedJson);

    /// <summary>
    /// The page as it stands with one row's payload open over it, landing on the panel so a reader
    /// far down the table is taken to what they just opened.
    /// </summary>
    private string JsonLink(string id) =>
        $"{Link(Descending, Events.Page)}&json={Uri.EscapeDataString(id)}#{JsonDialog.Anchor}";

    protected override async Task OnParametersSetAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);

        string? Value(string name) =>
            query.TryGetValue(name, out var found) ? found.LastOrDefault() : null;

        Stream = IdChoice.Of(StreamTypes, Value("stream"));
        Choice = TypeChoice.Of(EventTypes, Value("type"));
        Text = Value("text");
        Descending = !string.Equals(Value("dir"), "asc", StringComparison.OrdinalIgnoreCase);
        PageSize = InstanceQuery.PageSizeOf(Value("size"), HttpContext);

        // Only one word opens them, so anything else the address might say — including the word an
        // older link used for folded — leaves the page as it opens, which is folded.
        PayloadsOpen = string.Equals(Value("payloads"), Open, StringComparison.OrdinalIgnoreCase);

        // A choice with nothing to look for is not asked about. Its key is null, and null narrows
        // to everything rather than to nothing — so asking would answer the name of one type, or of
        // one stream, with the whole log.
        if (Choice.ShowsNothing || Stream.ShowsNothing)
        {
            Events = new StoredStreamEvents([], Total: 0, Page: 1, TotalPages: 1, Error: null);

            return;
        }

        Events = await Store.Events(new StreamedEventFilter(
            Stream.Pattern,
            Choice.Key,
            Text,
            Descending,
            int.TryParse(Value("page"), out var asked) ? asked : 1,
            PageSize));
    }

    /// <summary>
    /// The properties of one payload, a name and a value each, with the properties of any value one
    /// holds nested under it.
    /// </summary>
    /// <remarks>
    /// Draws itself, because a payload nests as deep as the describer read it. Inside a cell rather
    /// than as rows: the whole payload is one column of a row about the event, so there are no
    /// columns of its own to keep anything lined up with.
    /// <para>
    /// Names and values both mark what the filter was typed against: the store matched the payload
    /// as it was written, and a name is in that text as much as a value is.
    /// </para>
    /// </remarks>
    private RenderFragment<IReadOnlyList<DomainPropertyValue>> Pairs => properties =>
        @<ul class="pairs">
            @foreach (var property in properties)
            {
                <li>
                    <span class="pair-name"><Highlighted Text="@property.Name" Needle="@Text"/></span>

                    @if (property.Children.Count == 0)
                    {
                        <span class="pair-value">
                            @if (property.Value is null)
                            {
                                <text>—</text>
                            }
                            else
                            {
                                <Highlighted Text="@property.Value" Needle="@Text"/>
                            }
                        </span>
                    }
                    else
                    {
                        @* How many there are, when it is a list. A single shape says nothing here
                           that the pairs under it do not say better. *@
                        @if (property.Value is not null)
                        {
                            <span class="pair-value"><Highlighted Text="@property.Value" Needle="@Text"/></span>
                        }

                        @Pairs(property.Children)
                    }
                </li>
            }
        </ul>;

}
