@inherits LayoutComponentBase
@using Memoria.Web.Extensibility
@inject NavigationManager Navigation
@inject Memoria.Web.Data.StoreCapabilities Store
@inject CurrentService Current
@inject AuthenticationSettings SignIn

<header>
    @* The project's own mark, the same artwork the tab icon is cut from. An <img> rather than the
       inline SVG that used to stand here: this is a painted illustration with gradients on every
       face, not a shape a token could recolour, so there is nothing for it to follow. It carries
       its own colour in both themes — the cubes are saturated enough to hold against the light
       ground and the dark one alike, which is why no second file is shipped for dark.

       alt="" because the link says Memoria beside it, and a screen reader naming the mark as well
       would say it twice. *@
    <a class="brand" href="">
        <img class="mark" src="@Assets["logo.png"]" alt=""/>
        Memoria
    </a>
    <nav>
        @* Every item on the bar and under its headings is fronted by the mark its tile wears on
           the home page, so a menu is read at a glance the way the tiles are, and a place looks
           the same whichever way it is reached. *@
        <NavLink href="" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Home"/>Home</NavLink>

        @* The bar is the service's while a service is being read: its name, leading to its own
           page, and then the menus over its models exactly as they were drawn for the one store.
           Outside a service there are no models to menu — Home lists the services, and the
           settings are the tool's — so the bar is Home and Settings alone. *@
        @if (Current.Inside)
        {
        <NavLink href="@Current.Segment" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Overview"/>@Current.Name</NavLink>

        @* <details> rather than a hover menu: it opens on touch and on the keyboard with no
           script, which matters because these pages render statically. *@
        @* Named only while both models are laid out. With one model alone there is no choice for
           a heading to stand for, so its sections take the bar directly — see below. *@
        @if (Shown.Both)
        {
        @* Each of the three concerns is a heading over the pages that hold it rather than a link
           of its own: its own overview, the types the model declares, and what has been stored of
           them. The heading names the group without going anywhere — the overview under it is the
           page the heading would have led to, and it is listed with the other two so the whole
           group is reached the same way. Every link matches exactly, so the one you are on is the
           only one marked. *@
        <details class="menu">
            <summary class="@(InSection("streamed") ? "active" : null)"><SectionMark Kind="SectionKind.Streamed"/>Streamed</summary>
            <div class="submenu">
                <NavLink href="@At("streamed")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Overview"/>Overview</NavLink>

                <div class="submenu-group">
                    <span class="submenu-label">Events</span>
                    <NavLink href="@At("streamed/events")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Overview"/>Overview</NavLink>
                    <NavLink href="@At("streamed/events/types")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Types"/>Types</NavLink>
                    <NavLink href="@At("streamed/events/data")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Data"/>Data</NavLink>
                </div>

                <div class="submenu-group">
                    <span class="submenu-label">Aggregates</span>
                    <NavLink href="@At("streamed/aggregates")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Overview"/>Overview</NavLink>
                    <NavLink href="@At("streamed/aggregates/types")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Types"/>Types</NavLink>
                    <NavLink href="@At("streamed/aggregates/data")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Data"/>Data</NavLink>
                </div>

                <div class="submenu-group">
                    <span class="submenu-label">Projections</span>
                    <NavLink href="@At("streamed/projections")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Overview"/>Overview</NavLink>
                    <NavLink href="@At("streamed/projections/types")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Types"/>Types</NavLink>
                    <NavLink href="@At("streamed/projections/data")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Data"/>Data</NavLink>
                </div>

                @* One link rather than a group: a stream is declared and nothing else, so there is
                   no pair of pages to choose between. It follows the three because it is the one
                   thing here the DCB menu beside it has no answer to. *@
                <NavLink href="@At("streamed/streams")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Streams"/>Streams</NavLink>
            </div>
        </details>

        <details class="menu">
            <summary class="@(InSection("dcb") ? "active" : null)"><SectionMark Kind="SectionKind.Dcb"/>DCB</summary>
            <div class="submenu">
                <NavLink href="@At("dcb")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Overview"/>Overview</NavLink>

                <div class="submenu-group">
                    <span class="submenu-label">Events</span>
                    <NavLink href="@At("dcb/events")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Overview"/>Overview</NavLink>
                    <NavLink href="@At("dcb/events/types")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Types"/>Types</NavLink>
                    <NavLink href="@At("dcb/events/data")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Data"/>Data</NavLink>
                </div>

                <div class="submenu-group">
                    <span class="submenu-label">Aggregates</span>
                    <NavLink href="@At("dcb/aggregates")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Overview"/>Overview</NavLink>
                    <NavLink href="@At("dcb/aggregates/types")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Types"/>Types</NavLink>
                    <NavLink href="@At("dcb/aggregates/data")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Data"/>Data</NavLink>
                </div>

                <div class="submenu-group">
                    <span class="submenu-label">Projections</span>
                    <NavLink href="@At("dcb/projections")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Overview"/>Overview</NavLink>
                    <NavLink href="@At("dcb/projections/types")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Types"/>Types</NavLink>
                    <NavLink href="@At("dcb/projections/data")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Data"/>Data</NavLink>
                </div>
            </div>
        </details>
        }
        else if (Shown.Streamed)
        {
        @* One model alone: each section is its own heading on the bar, holding the three pages
           the group under the model heading held, and the streams stand as the one plain link
           they were. The model's overview is not on the bar — the service's page is laid out
           for this model alone now — though it is still reached from a tile there. *@
        @Section("streamed/events", "Events", SectionKind.Events)
        @Section("streamed/aggregates", "Aggregates", SectionKind.Aggregates)
        @Section("streamed/projections", "Projections", SectionKind.Projections)
        <NavLink href="@At("streamed/streams")" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Streams"/>Streams</NavLink>
        }
        else
        {
        @Section("dcb/events", "Events", SectionKind.Events)
        @Section("dcb/aggregates", "Aggregates", SectionKind.Aggregates)
        @Section("dcb/projections", "Projections", SectionKind.Projections)
        }
        }

        @* The theme is picked under Settings rather than up here: it is this browser's own
           preference, which is what that tab holds, and the bar is for places to go. And a place
           only an Administrator can go is left out for everyone else: the bar is for places to
           go, not places to be turned away from. Open, the policy is met by anyone and the link
           is there as it always was. *@
        <AuthorizeView Policy="@Roles.Administrator">
            <NavLink href="settings"><SectionMark Kind="SectionKind.Settings"/>Settings</NavLink>
        </AuthorizeView>
    </nav>

    @* What is the operator's own, at the far end of the bar away from the places to go: their
       preferences, which are this browser's and nobody else's business, and — signed in — their
       way out. Under their name, opened the way the section headings open, so the bar carries one
       kind of menu. Open, there is nobody to name, and the preferences stand as a plain link where
       the name would be. Sign-out is a form rather than a link, like every other write the pages
       send: ending a session is one, and it carries the same token the others do so a page
       elsewhere cannot end it on an operator's behalf. *@
    @if (SignIn is AuthenticationSettings.Disabled)
    {
        <nav class="operator" aria-label="Your settings">
            <NavLink href="preferences" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Preferences"/>Preferences</NavLink>
        </nav>
    }
    else
    {
        <AuthorizeView>
            <Authorized>
                <details class="menu operator">
                    <summary class="@(InSection("preferences", underService: false) ? "active" : null)"><SectionMark Kind="SectionKind.Operator"/>@context.User.Identity?.Name</summary>
                    <div class="submenu">
                        <NavLink href="preferences" Match="NavLinkMatch.All"><SectionMark Kind="SectionKind.Preferences"/>Preferences</NavLink>
                        <form method="post" action="logout">
                            <AntiforgeryToken/>
                            <button type="submit"><SectionMark Kind="SectionKind.SignOut"/>Sign out</button>
                        </form>
                    </div>
                </details>
            </Authorized>
        </AuthorizeView>
    }
</header>

<main>
    @Body
</main>

<footer>
    <div class="footer-left">
        <span class="copyright">&copy; @DateTime.UtcNow.Year Luca Briguglia</span>
        @* Down here rather than in the bar: the bar is for the store and the tool's own settings,
           and this is the page about the tool — the version, the licence, the documentation —
           which is what a footer is read for. It sits beside the copyright because that is the
           one line of it already written here. *@
        <span class="footer-separator" aria-hidden="true">&middot;</span>
        <a class="footer-link" href="about">About</a>
    </div>
    <div class="footer-links">
        <a class="footer-link" href="https://github.com/lucabriguglia/Memoria" target="_blank" rel="noopener noreferrer">
            <svg class="footer-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
