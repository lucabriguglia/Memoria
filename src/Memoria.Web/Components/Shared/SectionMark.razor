@* One mark, drawn from what it stands for. Every tile on the site and every item on the bar is
   entered through here, so a mark changing changes everywhere it is drawn and cannot be left half
   done.

   All of them share a box, a stroke and a linecap, and differ only in the path — which is what
   keeps a row of them looking like one set rather than so many drawings that happen to sit beside
   each other. Hidden from screen readers throughout: each one is drawn in front of a name that
   already says what it is, and read out it would be the same word twice. *@
<svg class="glyph" viewBox="0 0 20 20" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.6"
     stroke-linecap="round" stroke-linejoin="round">
    @switch (Kind)
    {
        @* A house: where the bar leads back to. *@
        case SectionKind.Home:
            <path d="M3.4 9.4 10 3.6l6.6 5.8"/>
            <path d="M5.3 8v8.4h9.4V8"/>
            <path d="M8.5 16.4v-4.4h3v4.4"/>
            break;

        @* Layers, stacked: the model is streams laid one on another, each an ordered course of
           events. Distinct from the running water of Streams beneath it, which is one course. *@
        case SectionKind.Streamed:
            <path d="M10 3.4 16.8 7 10 10.6 3.2 7z"/>
            <path d="M3.2 10.4 10 14l6.8-3.6"/>
            <path d="M3.2 13.8 10 17.4l6.8-3.6"/>
            break;

        @* A tag: a boundary under the DCB model is a query over the tags events carry, not a place
           they are kept. *@
        case SectionKind.Dcb:
            <path d="M3.4 10.4V4.2a.8.8 0 0 1 .8-.8h6.2l6.4 6.4-7 7z"/>
            <circle cx="7.2" cy="7.2" r="1.1"/>
            break;

        @* A compass: the page a reader takes their bearings from before choosing a direction. *@
        case SectionKind.Overview:
            <circle cx="10" cy="10" r="7.1"/>
            <path d="M12.9 7.1 8.8 8.8 7.1 12.9l4.1-1.7z"/>
            break;

        @* Braces: the shape a declaration is written in. *@
        case SectionKind.Types:
            <path d="M9 3.2c-2.2 0-1.8 2.9-1.8 4.3S6.3 10 4.9 10c1.4 0 2.3 1.1 2.3 2.5s-.4 4.3 1.8 4.3"/>
            <path d="M11 3.2c2.2 0 1.8 2.9 1.8 4.3s.9 2.5 2.3 2.5c-1.4 0-2.3 1.1-2.3 2.5s.4 4.3-1.8 4.3"/>
            break;

        @* A store, which is where what was declared ended up. *@
        case SectionKind.Data:
            <ellipse cx="10" cy="5.4" rx="5.6" ry="2.3"/>
            <path d="M4.4 5.4v9.2c0 1.3 2.5 2.3 5.6 2.3s5.6-1 5.6-2.3V5.4"/>
            <path d="M4.4 10c0 1.3 2.5 2.3 5.6 2.3s5.6-1 5.6-2.3"/>
            break;

        @* A bolt: something that happened, and the only thing here that is not a place. *@
        case SectionKind.Events:
            <path d="M11.4 2.6 5.2 11.2h4.2l-.8 6.2 6.2-8.6h-4.2z"/>
            break;

        @* A box, assembled from parts and closed: a write model is one thing made of its events. *@
        case SectionKind.Aggregates:
            <path d="M10 2.7 16.3 6.2v7.6L10 17.3 3.7 13.8V6.2z"/>
            <path d="M3.7 6.2 10 9.7l6.3-3.5"/>
            <path d="M10 9.7v7.6"/>
            break;

        @* A table: a read model is what the events were folded into to be read. *@
        case SectionKind.Projections:
            <rect x="3.2" y="4.3" width="13.6" height="11.4" rx="1.6"/>
            <path d="M3.2 8.3h13.6"/>
            <path d="M9 8.3v7.4"/>
            break;

        @* Water, running: a stream is the one thing here that is a course rather than a container. *@
        case SectionKind.Streams:
            <path d="M3 6.4c1.9-2 4.2-2 6.1 0s4.2 2 6.1 0"/>
            <path d="M3 10c1.9-2 4.2-2 6.1 0s4.2 2 6.1 0"/>
            <path d="M3 13.6c1.9-2 4.2-2 6.1 0s4.2 2 6.1 0"/>
            break;

        @* A hexagonal cell with its heart: a service is one bounded thing among others, named and
           closed, with a store of its own at its centre. Distinct from the box of an aggregate,
           which is one thing inside it. *@
        case SectionKind.Service:
            <path d="M10 2.6 16.4 6.3v7.4L10 17.4 3.6 13.7V6.3z"/>
            <circle cx="10" cy="10" r="2.2"/>
            break;

        @* A book, open: the one tile that leads out of the tool to where it is written up. *@
        case SectionKind.Documentation:
            <path d="M10 5.6c-1.4-1.2-3.4-1.6-6.3-1.4v11.2c2.9-.2 4.9.2 6.3 1.4 1.4-1.2 3.4-1.6 6.3-1.4V4.2c-2.9-.2-4.9.2-6.3 1.4z"/>
            <path d="M10 5.6v11.2"/>
            break;

        @* A cog: what the tool runs on, and is adjusted at. *@
        case SectionKind.Settings:
            <circle cx="10" cy="10" r="2.5"/>
            <circle cx="10" cy="10" r="5.4"/>
            <path d="M10 2.4v2.2M10 15.4v2.2M2.4 10h2.2M15.4 10h2.2"/>
            <path d="M4.6 4.6l1.6 1.6M13.8 13.8l1.6 1.6M4.6 15.4l1.6-1.6M13.8 6.2l1.6-1.6"/>
            break;

        @* A person: the operator, named over what is theirs. *@
        case SectionKind.Operator:
            <circle cx="10" cy="6.6" r="3.2"/>
            <path d="M3.8 17.2c.6-3.6 3-5.4 6.2-5.4s5.6 1.8 6.2 5.4"/>
            break;

        @* Sliders: a preference is a setting slid to where this browser likes it. *@
        case SectionKind.Preferences:
            <path d="M3.2 6.2h2.5M9.1 6.2h7.7"/>
            <circle cx="7.4" cy="6.2" r="1.7"/>
            <path d="M3.2 13.8h7.7M14.4 13.8h2.4"/>
            <circle cx="12.7" cy="13.8" r="1.7"/>
            break;

        @* A door with the way through it: out. *@
        case SectionKind.SignOut:
            <path d="M8.4 3.4H4.6a1 1 0 0 0-1 1v11.2a1 1 0 0 0 1 1h3.8"/>
            <path d="M12.8 6.4 16.4 10l-3.6 3.6"/>
            <path d="M16.4 10H7.6"/>
            break;
    }
</svg>

@code {

    // The marks the tiles are entered by. One component rather than a copy in each page that draws
    // one: three of the six are drawn on the home page, both overviews and a section page, and the
    // set only reads as a set for as long as every copy of it is the same drawing.

    /// <summary>What the tile this is drawn on leads to.</summary>
    [Parameter]
    [EditorRequired]
    public SectionKind Kind { get; set; }

}
