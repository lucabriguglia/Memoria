@page "/{service}/dcb/aggregates"
@using Memoria.Web.Extensibility
@inject CurrentService Current

<PageTitle>DCB @Heading</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <a href="@Service">@Current.Name</a>
    <span aria-hidden="true">/</span>
    <ModelCrumb Model="ModelStore.Dcb"/>
    <span aria-current="page">Aggregates</span>
</nav>

<h1>@Heading</h1>

<SectionTiles TypesHref="@($"{Service}/dcb/aggregates/types")" DataHref="@($"{Service}/dcb/aggregates/data")">
    <TypesDetail>
        @Count(Catalogue.DcbAggregates.Count, "aggregate") the model declares, addressed by
        @Count(Catalogue.DcbAggregateIds.Count, "identifier").
    </TypesDetail>
    <DataDetail>The aggregates that have been stored, read one identifier at a time.</DataDetail>
</SectionTiles>

@if (Catalogue.DcbAggregates.Count == 0)
{
    <p class="lede">
        No DCB aggregates are registered. Upload a zip of assemblies on the
        <a href="settings">settings</a> page.
    </p>
}

@code {

    /// <summary>The service this page sits under: the first segment of its address.</summary>
    [Parameter]
    public string Service { get; set; } = string.Empty;

    /// <summary>
    /// What the page is, for the heading and the title. One value for both, so they cannot drift
    /// apart; the tab puts the section in front of it, because a tab is read away from the
    /// breadcrumb that says which section this is.
    /// </summary>
    private const string Heading = "Aggregates";

    private DomainTypeCatalogue Catalogue => Current.Catalogue;

    private static string Count(int count, string noun) =>
        count == 1 ? $"1 {noun}" : $"{count} {noun}s";

}
