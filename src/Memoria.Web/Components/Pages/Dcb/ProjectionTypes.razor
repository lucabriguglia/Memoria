@page "/{service}/dcb/projections/types"
@using Memoria.Web.Extensibility
@inject CurrentService Current

<PageTitle>DCB @Heading</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <a href="@Service">@Current.Name</a>
    <span aria-hidden="true">/</span>
    <ModelCrumb Model="ModelStore.Dcb"/>
    <a href="@Service/dcb/projections">Projections</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Types</span>
</nav>

<h1>@Heading</h1>

@if (Projections.Count == 0)
{
    <p class="lede">
        No DCB projections are registered. Upload a zip of assemblies on the
        <a href="settings">settings</a> page.
    </p>
}
else
{
    <div class="panels">
        @* The identifiers an projection can be loaded by fold under the row that names it: the same
           links the identifiers tab lists, reached without first choosing the projection and then
           the tab. Read off the type on its own rather than out of a full description: the list
           has every projection in it, and describing each one constructs it to read its event
           filter, which nothing on a row shows. *@
        <TypeIndex Label="Projections"
                   Noun="projection"
                   Types="Projections"
                   Selected="Selected?.Type"
                   Address="@Address"
                   Tab="@Tab"
                   Query="@Query"
                   Links="Under"/>

        <section class="panel panel-detail">
            @* Selected is only null when the list is empty, which the branch above already covers. *@
            @if (Selected is { } selected)
            {
                @* The same name the row in the list carries, so the heading answers the click that
                   reached it — and the version is part of it, because two versions of one name are
                   two rows there. The class it is bound from is the first fact on the info tab. *@
                <h2>@BoundAs(selected.Type)</h2>
                <ObsoleteNote Type="selected.Type"/>

                @* The four views of it, drawn by the component the detail page opens over a stored
                   row as well: what is true of a declared type is the same wherever it is read, and
                   there is one place it is written. *@
                <TypeView Description="selected"
                          Kind="ModelKind.Projection"
                          Store="ModelStore.Dcb"
                          Tab="@Tab"
                          TabLink="TabLink"
                          DataLink="@(identifier => DataLink(selected.Type, identifier))"/>
            }
        </section>
    </div>
}

@code {

    /// <summary>The service this page sits under: the first segment of its address.</summary>
    [Parameter]
    public string Service { get; set; } = string.Empty;

    /// <summary>
    /// What the page is, for the heading and the title. One value for both, so they cannot drift
    /// apart; the tab puts the section and the group in front of it, because a tab is read away
    /// from the breadcrumb that says which of them this page sits under.
    /// </summary>
    private const string Heading = "Projection Types";

    /// <summary>The page's own address, which every link in the list and the tabs return to.</summary>
    private string Address => $"{Service}/dcb/projections/types";

    [SupplyParameterFromQuery(Name = "type")]
    private string? SelectedName { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    private string? RequestedTab { get; set; }

    /// <summary>What was typed into the list's filter, or null when nothing was.</summary>
    [SupplyParameterFromQuery(Name = "q")]
    private string? Query { get; set; }

    /// <summary>
    /// Which view is open, matched against the four there are so an unknown name in the address
    /// opens the one a type opens with rather than an empty panel.
    /// </summary>
    private string Tab => TypeView.Match(RequestedTab);

    private IReadOnlyList<Type> Projections => Current.Catalogue.DcbProjections;

    /// <summary>
    /// The projection being shown: the one asked for, or the first the list offers.
    /// </summary>
    private DomainTypeDescription? Selected =>
        TypeIndex.Choose(Projections, SelectedName, Query) is { } type
            ? DomainTypeDescriber.Describe(type, Current.Catalogue.DcbProjectionIds)
            : null;

    /// <summary>
    /// What an projection is stored under, falling back to the class when it carries no attribute —
    /// an unbound type is still worth listing, and the panel beside the list says it is unbound.
    /// </summary>
    /// <remarks>
    /// Written as the name and a version after it rather than as the store's own key: the key joins
    /// the two with a colon because something has to read them back apart, which is the store's
    /// need and not the reader's. Here they are a name and its version, said the way a version is
    /// said. The key itself is on the info tab, in the two halves it is made of.
    /// </remarks>
    private static string BoundAs(Type projection) => DomainTypeDescriber.LabelOf(projection);

    /// <summary>
    /// What folds under one projection's row: a link per identifier that addresses it, through to
    /// what has been stored under that identifier.
    /// </summary>
    private IReadOnlyList<TypeIndex.Link> Under(Type projection) =>
        DomainTypeDescriber.IdentifiersOf(projection, Current.Catalogue.DcbProjectionIds)
            .Select(identifier => new TypeIndex.Link(DataLink(projection, identifier), identifier.Name))
            .ToList();

    /// <summary>
    /// Through to what has been stored of one of these. The projection travels with the identifier
    /// because an identifier alone does not say what it addresses — and it is passed in rather than
    /// taken from the selection, because the list links rows that are not selected.
    /// </summary>
    private string DataLink(Type projection, Type identifier) =>
        $"{Service}/dcb/projections/data" +
        $"?type={Uri.EscapeDataString(projection.FullName ?? string.Empty)}" +
        $"&id={Uri.EscapeDataString(identifier.FullName ?? string.Empty)}";

    /// <summary>
    /// A tab of the projection already chosen, keeping what was typed into the list.
    /// </summary>
    private string TabLink(string tab) => TypeIndex.LinkTo(Address, Selected?.Type, tab, Query);

}
