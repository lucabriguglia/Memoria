@page "/"
@using Memoria.Web.Data
@using Memoria.Web.Extensibility
@inject DomainTypeRegistry Types
@inject ServiceStores Stores
@inject ServiceAccess Access

<PageTitle>Memoria</PageTitle>

<h1>Memoria</h1>

@* The services installed that this operator may read, each the way into its own page. A service
   is a named set of domain assemblies read over one store, declared by the manifest in the zip
   that brought it; what a reader picks here is which one to read. Drawn as the tiles every
   section of the site is entered by, one a service, so the front door and the doors behind it
   are the same shape. *@
@if (Services.Count == 0)
{
    <p class="lede">
        No services are installed. A zip uploaded under
        <a href="settings">Settings</a> declares the services it brings, and each is listed here.
    </p>
}
else if (Visible.Count == 0)
{
    @* Silence is nobody: an operator whose sign-in carries nothing a manifest or the
       configuration names sees no service, and is told that is why, and who can change it —
       rather than a page that looks like a tool with nothing in it. *@
    <p class="lede">
        Nothing your sign-in carries names a service. A service is read by the operators its
        manifest names, or by anyone the tool's configuration maps to a role for every service.
        Ask whoever runs the service you were after, or whoever runs this tool, to name yours.
    </p>
}
else
{
    <p class="lede">
        The services installed, each a set of domain assemblies read over its own store. Pick one
        to read its events, and the aggregates and projections snapshotted from them.
    </p>

    @* One to a row: a service is read by its name and the sentence under it, and a sentence wants
       the measure the page gives prose, not the third of it a tile in a grid gets. *@
    <ul class="tiles services">
        @foreach (var service in Visible)
        {
            <li>
                @* Shown by the name the manifest wrote; reached by the address that name makes. *@
                <a href="@service.Slug">
                    <SectionMark Kind="SectionKind.Overview"/>
                    <span class="body">
                        <span class="name">@service.Name</span>
                        @* What the service is, in its manifest's own words, when the manifest
                           says. Not which models it registered under: every service said one of
                           three things there, which told a reader nothing its own page does not
                           lay out better. A store that cannot be reached is still said here,
                           first, where the person who can fix the configuration is looking. *@
                        @if (Detail(service) is { } detail)
                        {
                            <span class="detail">@detail</span>
                        }
                    </span>
                </a>
            </li>
        }
    </ul>
}

@code {

    /// <summary>Who is asking, as the sign-in says; open, nobody, and everything is theirs to read.</summary>
    [CascadingParameter]
    public Task<AuthenticationState>? AuthenticationState { get; set; }

    private IReadOnlyList<Service> Services => Types.Current.Services;

    /// <summary>The services this operator may read: named by their manifest, or by a global role.</summary>
    private IReadOnlyList<Service> Visible { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var user = AuthenticationState is { } state ? (await state).User : new System.Security.Claims.ClaimsPrincipal();

        Visible = Services.Where(service => Access.Grants(user, Roles.Reader, service)).ToList();
    }

    /// <summary>
    /// The line under a service's name: that its store cannot be reached, and why, before
    /// anything else; else what its manifest says it is; else nothing, and no line is drawn.
    /// </summary>
    private string? Detail(Service service) =>
        Stores.For(service).Problem is { } problem ? $"Unreachable: {problem}" : service.Description;

}
