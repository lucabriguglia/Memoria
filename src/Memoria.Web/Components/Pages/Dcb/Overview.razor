@page "/{service}/dcb"
@using Memoria.Web.Extensibility
@inject CurrentService Current

<PageTitle>DCB @Heading</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <a href="@Service">@Current.Name</a>
    <span aria-hidden="true">/</span>
    <ModelCrumb Model="ModelStore.Dcb" IsCurrent="true"/>
</nav>

<h1>@Heading</h1>
<p class="lede">
    The types uploaded through <a href="settings">settings</a> that belong to the dynamic
    consistency boundary model, and what they are addressed by.
</p>

@* One tile a section, each the way into it and each the same shape — which is the shape the pages
   under it are entered by too, so a reader crossing from here to a section meets the same tile
   twice rather than two arrangements of the same four words. What the section holds is counted on
   it: the same fact whichever of the pages under it you go on to open.

   Three tiles rather than the streamed model's four: a DCB boundary is a query over tags rather
   than a place events are kept, so there are no streams here to hold them. *@
<ul class="tiles">
    <li>
        <a href="@Service/dcb/events">
            <SectionMark Kind="SectionKind.Events"/>
            <span class="body">
                <span class="name">Events</span>
                <span class="detail">@Count(Catalogue.DcbEvents.Count, "event") the model can apply.</span>
            </span>
        </a>
    </li>
    <li>
        <a href="@Service/dcb/aggregates">
            <SectionMark Kind="SectionKind.Aggregates"/>
            <span class="body">
                <span class="name">Aggregates</span>
                <span class="detail">
                    @Count(Catalogue.DcbAggregates.Count, "aggregate"), addressed by
                    @Count(Catalogue.DcbAggregateIds.Count, "identifier").
                </span>
            </span>
        </a>
    </li>
    <li>
        <a href="@Service/dcb/projections">
            <SectionMark Kind="SectionKind.Projections"/>
            <span class="body">
                <span class="name">Projections</span>
                <span class="detail">
                    @Count(Catalogue.DcbProjections.Count, "projection"), addressed by
                    @Count(Catalogue.DcbProjectionIds.Count, "identifier").
                </span>
            </span>
        </a>
    </li>
</ul>

@if (Catalogue.Count == 0)
{
    <p class="lede">
        Nothing is registered yet. Upload a zip of assemblies on the
        <a href="settings">settings</a> page.
    </p>
}

@code {

    /// <summary>The service this page sits under: the first segment of its address.</summary>
    [Parameter]
    public string Service { get; set; } = string.Empty;

    /// <summary>
    /// What the page is, for the heading and the title. One value for both, so they cannot drift
    /// apart; the tab puts the section in front of it, because a tab is read away from the
    /// breadcrumb that says which section this is. What DCB stands for is spelled out in the line
    /// under the heading rather than in the heading itself.
    /// </summary>
    private const string Heading = "Overview";

    private DomainTypeCatalogue Catalogue => Current.Catalogue;

    private static string Count(int count, string noun) =>
        count == 1 ? $"1 {noun}" : $"{count} {noun}s";

}
