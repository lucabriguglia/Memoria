@page "/{service}/streamed/events/detail"
@using Memoria.Web.Extensibility
@using Microsoft.AspNetCore.WebUtilities
@inject CurrentService Current
@inject IStreamedReads Store
@inject NavigationManager Navigation

<PageTitle>@Heading @Title</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <a href="@Service">@Current.Name</a>
    <span aria-hidden="true">/</span>
    <ModelCrumb Model="ModelStore.Streamed"/>
    <a href="@Service/streamed/events">Events</a>
    <span aria-hidden="true">/</span>
    @* The list this row was opened from, narrowed to the event's type when a registered one
       claims it, so the step back arrives where the click came from. *@
    <a href="@BackToList">Data</a>
    <span aria-hidden="true">/</span>
    @* What the page is, rather than which row reached it. The trail says where this sits; the
       heading says what kind of thing is open, and the browser tab carries the key so two of these
       are told apart where they have to be. *@
    <span aria-current="page">Detail</span>
</nav>

@if (StreamId is null || Id is null)
{
    <h1>@Heading</h1>
    <p class="alert" role="alert">
        That address names no event: it carries no stream, or no key. Start again from
        <a href="@Service/streamed/events/data">events</a>.
    </p>
}
else
{
    @* Named as every list here names a type: what the log wrote the row under, and the version of
       that binding. Two versions of one name are two events, and the heading has to say which. *@
    <div class="page-header">
        <h1>@Heading</h1>

        @* Across from the name, because it is about the name: the heading says what this row was
           written as, and this is the way to what that type actually declares. Not among the tabs
           under it — those are three views of this one stored row, and the type is true of every
           row of it. Only when something uploaded describes the type: a key nothing registered
           claims has no declaration to open, and a button leading to an empty sheet would be worse
           than none. The mark is the one the types pages are entered by everywhere else. *@
        @if (EventType is not null)
        {
            <a class="button-mark quiet" href="@ViewTypeLink(TypeView.InfoTab)">
                <SectionMark Kind="SectionKind.Types"/>
                View Type
            </a>
        }
    </div>

    @* The three views of the row, or why there are none to draw: the store failing to answer at
       all, or nothing under the address. Said in place of the tabs rather than under each of them,
       since there would be nothing to switch between. *@
    @if (Error is not null)
    {
        <p class="alert" role="alert">@Error</p>
    }
    else if (Stored is null)
    {
        <p class="empty">@Missing</p>
    }
    else
    {
        @* Drawn by the component a model's events tab opens a row in, so a row met in a history
           and the same row met here read alike. *@
        <EventView Event="Stored.Event"
                   Store="ModelStore.Streamed"
                   StreamId="@Stored.StreamId"
                   Id="@Stored.Id"
                   Tab="@Tab"
                   TabLink="TabLink"/>
    }

    @* What the row was written as, opened over whichever tab was being read. Last in the markup
       because it covers the page rather than sitting anywhere in it, and drawn only when the
       address asks for it — so the page underneath is the page a reader left. *@
    @if (ViewedType is { } viewed)
    {
        <TypeDialog Description="viewed"
                    Kind="ModelKind.Event"
                    Store="ModelStore.Streamed"
                    Tab="@View"
                    TabLink="ViewTypeLink"
                    CloseLink="@TabLink(Tab)"/>
    }
}

@code {

    /// <summary>The service this page sits under: the first segment of its address.</summary>
    [Parameter]
    public string Service { get; set; } = string.Empty;

    /// <summary>
    /// The stream the row was appended to, as the store holds it.
    /// </summary>
    /// <remarks>
    /// A page here is reached from a row that was shown, and that row carries the stream and the
    /// key. Asking for a stream type and its values instead would be asking this page to work back
    /// to what it was already told — and would leave a row whose stream no registered type claims
    /// unreachable, which is exactly the row worth opening.
    /// </remarks>
    private string? StreamId { get; set; }

    /// <summary>The key the row was written under, as <c>streamId:sequence</c>.</summary>
    private string? Id { get; set; }

    private StoredStreamEvent? Stored { get; set; }

    /// <summary>The store failing to answer at all, which is not the same as a payload it cannot read.</summary>
    private string? Error { get; set; }

    /// <summary>
    /// The registered type the stored key reads back into, or null when nothing uploaded claims it
    /// — or when there is no row to read a key off.
    /// </summary>
    /// <remarks>
    /// Looked for among the events some streamed model applies, which is the list the section's
    /// own pages list and narrow by, so the type this page names is one those pages can be
    /// narrowed to. Matched on the key rather than on the class, because the key is what the row
    /// holds.
    /// </remarks>
    private Type? EventType =>
        Stored is null
            ? null
            : Current.Catalogue.StreamedEvents.FirstOrDefault(@event =>
                DomainTypeDescriber.BindingOf(@event)?.Key == Stored.Event.Type);

    /// <summary>
    /// Which of the event's three views is showing, matched from the address by the component that
    /// draws them, so a view can be linked to, bookmarked, and gone back to.
    /// </summary>
    private string Tab { get; set; } = EventView.InfoTab;

    /// <summary>
    /// What the page is, for the heading and the title. Unlike the pages that list, this one is
    /// about one stored event, so the heading is what that event was written as rather than the
    /// name of a section — and the bare word when there is no row to read it off.
    /// </summary>
    private string Heading =>
        Stored is null ? "Event" : DomainTypeDescriber.LabelOfKey(Stored.Event.Type);

    /// <summary>
    /// Which one, for the browser tab: the key, which is what tells two of these apart where the
    /// heading cannot.
    /// </summary>
    private string Title => Id ?? string.Empty;

    /// <summary>
    /// Nothing under the address, said in place of the tabs there would be nothing to switch between.
    /// A fact about the store rather than a failure: the row was there when the link was made.
    /// </summary>
    private const string Missing =
        "No event is stored at that address. It may have been written under another key, or " +
        "removed since this link was made.";

    /// <summary>
    /// Back to the list this row was opened from, narrowed the way it was: to the event's type,
    /// when a registered one claims it.
    /// </summary>
    private string BackToList =>
        EventType is { } registered
            ? $"{Service}/streamed/events/data?type={Uri.EscapeDataString(registered.FullName ?? registered.Name)}"
            : $"{Service}/streamed/events/data";

    /// <summary>
    /// Everything that addresses the row itself: the stream and the key. The view is appended by
    /// whatever varies it.
    /// </summary>
    private string Address =>
        $"{Service}/streamed/events/detail?stream={Uri.EscapeDataString(StreamId ?? string.Empty)}" +
        $"&id={Uri.EscapeDataString(Id ?? string.Empty)}";

    /// <summary>
    /// One address for the whole page, so a link only changes what it means to change.
    /// </summary>
    /// <param name="tab">Which of the views to show.</param>
    /// <param name="view">Which view of the declared type to open over it, or null for none.</param>
    private string DetailLink(string tab, string? view = null) =>
        $"{Address}&tab={tab}" +
        (view is { Length: > 0 } ? $"&view={view}" : string.Empty);

    private string TabLink(string tab) => DetailLink(tab);

    /// <summary>
    /// Which view of the declared type is open over the page, or nothing when none is.
    /// </summary>
    /// <remarks>
    /// Named only when it is open, which is what makes every other link on the page close it: a
    /// reader who moves the page underneath has left the type behind, and carrying it along would
    /// leave a panel hanging over a row it is no longer about.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "view")]
    private string? RequestedView { get; set; }

    /// <summary>Which of the type's views to show once it is open.</summary>
    private string View => TypeView.Match(RequestedView);

    /// <summary>
    /// The type this row was written as, described, or null when the address is not asking for it
    /// or nothing registered claims the key. Described only when it is asked for: it walks the
    /// type's whole shape, and a page reading one stored row has no other use for it.
    /// </summary>
    private DomainTypeDescription? ViewedType =>
        !string.IsNullOrWhiteSpace(RequestedView) && EventType is { } registered
            ? DomainTypeDescriber.DescribeEvent(registered)
            : null;

    /// <summary>
    /// The page as it stands with one of the type's views open over it, landing on the panel.
    /// </summary>
    private string ViewTypeLink(string view) =>
        DetailLink(Tab, view) + $"#{TypeDialog.Anchor}";

    protected override async Task OnParametersSetAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);

        string? Value(string name) =>
            query.TryGetValue(name, out var found) ? found.LastOrDefault() : null;

        // Matched against the ones the page has, so an unknown name in the address opens the one
        // it opens with rather than a blank page.
        Tab = EventView.Match(Value("tab"));

        // Both are the store's rather than matched against anything registered: a row appended to
        // a stream no uploaded type claims is still the store's own row, and the one worth opening.
        StreamId = Value("stream") is { Length: > 0 } stream ? stream : null;
        Id = Value("id") is { Length: > 0 } id ? id : null;

        if (StreamId is null || Id is null)
        {
            return;
        }

        var read = await Store.Event(new StreamedEventAddress(StreamId, Id));

        Stored = read.Event;
        Error = read.Error;
    }

}
