@page "/"
@using Memoria.Web.Extensibility
@inject DomainTypeRegistry Types
@inject Memoria.Web.Data.StoreCapabilities Store

<PageTitle>Memoria</PageTitle>

<h1>Memoria</h1>

@* The services installed, each the way into its own page. A service is a named set of domain
   assemblies read over one store, declared by the manifest in the zip that brought it; what a
   reader picks here is which one to read. Drawn as the tiles every section of the site is
   entered by, one a service, so the front door and the doors behind it are the same shape. *@
@if (Services.Count == 0)
{
    <p class="lede">
        No services are installed. A zip uploaded under
        <a href="settings">Settings</a> declares the services it brings, and each is listed here.
    </p>
}
else
{
    <p class="lede">
        The services installed, each a set of domain assemblies read over its own store. Pick one
        to read its events, and the aggregates and projections snapshotted from them.
    </p>

    <ul class="tiles services">
        @foreach (var service in Services)
        {
            var shown = ShownModels.Of(Types.Current.For(service), Store);

            <li>
                @* Shown by the name the manifest wrote; reached by the address that name makes. *@
                <a href="@service.Slug">
                    <SectionMark Kind="SectionKind.Overview"/>
                    <span class="body">
                        <span class="name">@service.Name</span>
                        @* Which models the service registered types under, the same words its
                           own page heads them with — so a reader knows before opening it whether
                           they will find streams, boundaries, or both. *@
                        <span class="detail">@Models(shown)</span>
                    </span>
                </a>
            </li>
        }
    </ul>
}

@code {

    private IReadOnlyList<Service> Services => Types.Current.Services;

    /// <summary>What a service registered under, in the words the site names the models by.</summary>
    private static string Models(ShownModels shown) => shown switch
    {
        { Both: true } => "Streamed and DCB.",
        { Streamed: true } => "Streamed.",
        _ => "DCB."
    };

}
