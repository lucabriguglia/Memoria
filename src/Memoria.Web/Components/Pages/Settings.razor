@page "/settings"
@attribute [Authorize(Policy = Roles.Administrator)]
@using Memoria.Web.Extensibility
@inject ExtensionStore Store
@inject DomainTypeRegistry Types

<PageTitle>Settings</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Settings</span>
</nav>

<h1>Settings</h1>
@* Two views of one setting — the archives that were uploaded and the types they turned out to hold
   — and, after them, the settings that are this browser's rather than the server's. Switched by the
   address rather than by script, the same way the aggregate pages switch theirs, so a view can be
   linked to and the back button steps between them. Marked with aria-current because these are
   places to go, not scripted tabs. *@
<nav class="tabs" aria-label="Settings views">
    <a id="tab-@InstalledTab" href="settings?tab=@InstalledTab"
       aria-current="@(Tab == InstalledTab ? "page" : null)">Installed</a>
    <a id="tab-@TypesTab" href="settings?tab=@TypesTab"
       aria-current="@(Tab == TypesTab ? "page" : null)">Types</a>
    @* Last of the three, and the only one that is nobody else's business: the two before it are the
       server's state, read by everyone; this one is how this browser draws it. *@
    <a id="tab-@PreferencesTab" href="settings?tab=@PreferencesTab"
       aria-current="@(Tab == PreferencesTab ? "page" : null)">Preferences</a>
</nav>

@* Each panel is named by the tab that reaches it, so the label is written once. *@
@if (Tab == InstalledTab)
{
    <section class="tab-panel" aria-labelledby="tab-@InstalledTab">
        <p class="lede">
            The zips of assemblies uploaded, each holding domain types. They are read as
            soon as they arrive — the application does not restart. The mark on a row opens the
            assemblies in that zip and the types registered from each.
        </p>

        @if (Archives.Count == 0)
        {
            <p class="empty">Nothing uploaded yet.</p>
        }
        else
        {
            @* The same table the stored data is read in, because a list of what is installed is a
               list of rows the server holds and there is no reason for it to be a second kind of
               table. The columns are declared so the file keeps the room and the three facts beside
               it stay where they are however long a name happens to be. *@
            <table class="grid archives">
                <thead>
                <tr>
                    <th scope="col" class="col-file">File</th>
                    <th scope="col" class="col-size">Size</th>
                    <th scope="col" class="col-uploaded">Uploaded</th>
                    @* The way into what a row brought, and nothing else: a mark and the word
                       above it, like the JSON column on a page of the log. *@
                    <th scope="col" class="col-types marked">Types</th>
                    <th class="col-actions"><span class="visually-hidden">Actions</span></th>
                </tr>
                </thead>
                <tbody>
                @for (var index = 0; index < Archives.Count; index++)
                {
                    var archive = Archives[index];
                    var dialog = $"delete-{index}";

                    <tr>
                        <td class="name">@archive.Name</td>
                        <td>@($"{archive.Length / 1024:n0} KB")</td>
                        <td>@archive.UploadedUtc.ToLocalTime().ToString("g")</td>
                        @* A mark rather than a word: the column is one link per row and the word
                           repeats down it. The name it is read out by tells a row from the one
                           above, which its place in the column alone would not. The site's mark for
                           a declaration, because a list of types is what opens. Offered on every
                           row, including one that brought nothing: that is exactly the row worth
                           looking into. *@
                        <td class="marked">
                            <a class="icon-link" href="@TypesLink(archive)"
                               aria-label="View the types registered from @archive.Name"
                               title="View the types registered from @archive.Name">
                                <SectionMark Kind="SectionKind.Types"/>
                            </a>
                        </td>
                        <td class="actions">
                            @* Asked before it happens, because removing an archive takes the types it
                               brought away from everyone, not just from whoever pressed it. Opened the same
                               way as the upload form: the address says which one, so the question survives
                               having no script to ask it. *@
                            @* A bin rather than a word: the column is one link per row and the word repeats
                               down it. The name it is read out by carries the file, so a row is told apart
                               by more than its position — and the dialog it opens still asks in words. *@
                            <a class="icon-link delete" href="settings?delete=@Uri.EscapeDataString(archive.Name)"
                               aria-label="Delete @archive.Name" title="Delete @archive.Name"
                               onclick="event.preventDefault(); document.getElementById('@dialog').showModal()">
                                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"
                                     fill="none" stroke="currentColor" stroke-width="1.5"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M2.5 4h11M6.5 4V2.5h3V4M4 4l.6 9a1 1 0 0 0 1 1h4.8a1 1 0 0 0 1-1L12 4" />
                                    <path d="M6.75 6.75v4.5M9.25 6.75v4.5" />
                                </svg>
                            </a>

                            <dialog id="@dialog" class="dialog" open="@(DeleteAsked == archive.Name)">
                                <h2>Remove @archive.Name?</h2>
                                <p>
                                    The types it brought are unregistered for everyone using this server.
                                    Anything it holds can be uploaded again afterwards.
                                </p>
                                <form method="post" action="settings/delete" class="dialog-actions">
                                    <AntiforgeryToken/>
                                    <input type="hidden" name="name" value="@archive.Name"/>
                                    <button type="submit" class="danger">Remove</button>
                                    <a class="quiet" href="settings"
                                       onclick="event.preventDefault(); document.getElementById('@dialog').close()">Cancel</a>
                                </form>
                            </dialog>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }

        @* A link rather than a button, so it still opens without scripting: the address says the form is
           wanted and the dialog is rendered open. With scripting it is a modal and the page stays put. *@
        <p class="actions-row">
            <a class="button" href="settings?upload=1"
               onclick="event.preventDefault(); document.getElementById('upload').showModal()">Upload</a>
        </p>

        @* What the last upload or removal did, read where the button that did it was pressed. *@
        @Notice

        @Shared

        <dialog id="upload" class="dialog" open="@ShowUpload">
            <form method="post" enctype="multipart/form-data" action="settings/upload" class="upload">
                <AntiforgeryToken/>
                <h2>Upload</h2>
                <label for="files">Zip files</label>
                <input id="files" name="files" type="file" accept=".zip,application/zip" multiple required/>
                <p class="hint">
                    Assemblies are taken from anywhere in the archive and stored under one name each. An
                    assembly of the same name from an earlier upload is replaced.
                </p>
                <div class="dialog-actions">
                    <button type="submit" class="button">Upload</button>
                    <a class="quiet" href="settings"
                       onclick="event.preventDefault(); document.getElementById('upload').close()">Cancel</a>
                </div>
            </form>
        </dialog>

        @* One archive's contents, opened over the table it was listed in. Last in the markup because
           it covers the panel rather than sitting anywhere in it, and drawn only when the address
           names an archive that is installed — so the table behind it is the table a reader left. *@
        @if (Opened is { } opened)
        {
            <ArchiveTypesDialog Archive="opened" Catalogue="Catalogue" CloseLink="@InstalledLink"/>
        }
    </section>
}
else if (Tab == TypesTab)
{
    <section class="tab-panel" aria-labelledby="tab-@TypesTab">
        @* What the tab is, then when it was last true — one paragraph, because the second sentence
           is only worth reading against the first. *@
        <p class="lede">
            The domain types found in the uploaded assemblies, counted for each model that can use
            them. @Registered
        </p>

        @if (Catalogue.Count == 0)
        {
            <p class="empty">No domain types were found in the uploaded assemblies.</p>
        }
        else
        {
            @* Set beside each other the same way the home page sets the two models, so what one model
               registered is read against the other rather than down one list. The events are one
               bound set, but each column counts the ones its own models apply, so a column says what
               that model can fold rather than what was uploaded.

               A register each, in the table the rest of the site reads rows in. The model's name is
               the table's own heading rather than a title above it, spanning both columns because it
               names the pair and not either one of them — so a column is one object, the way the
               installed list is.

               Each still wrapped in a section of its own. Two tables put straight into the grid
               would be adjacent siblings, and the card rules in app.css join a run of adjacent
               tables into one shape — which is right down a page and wrong across two columns. *@
            <div class="models">
                <section class="model">
                    <table class="grid registered">
                        <colgroup>
                            <col class="col-kind"/>
                            <col class="col-count"/>
                        </colgroup>
                        <thead>
                        <tr>
                            <th scope="colgroup" colspan="2">Streamed</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var (mark, label, count) in StreamedCounts)
                        {
                            <tr>
                                <td class="name"><SectionMark Kind="@mark"/>@label</td>
                                <td class="count">@count</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </section>

                <section class="model">
                    <table class="grid registered">
                        <colgroup>
                            <col class="col-kind"/>
                            <col class="col-count"/>
                        </colgroup>
                        <thead>
                        <tr>
                            <th scope="colgroup" colspan="2">DCB</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var (mark, label, count) in DcbCounts)
                        {
                            <tr>
                                <td class="name"><SectionMark Kind="@mark"/>@label</td>
                                <td class="count">@count</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </section>
            </div>
        }

        <form method="post" action="settings/refresh" class="refresh">
            <AntiforgeryToken/>
            <button type="submit" class="button">Refresh types</button>
            <span class="hint">Reads every uploaded assembly again and registers the types from scratch.</span>
        </form>

        @* What the last refresh did, read where the button that did it was pressed. *@
        @Notice

        @Shared
    </section>
}
else
{
    <section class="tab-panel" aria-labelledby="tab-@PreferencesTab">
        @* The settings in the card the other two tabs read their rows in: a preference is a name
           with a value at the end of it, which is the shape of a row of stored data, and drawing it
           a second way would make one page out of two. Divs rather than a table because there is
           nothing to head — two rows of two, and the line under each is a sentence rather than a
           third column. *@
        <div class="preferences">
            @* First, because it is the one preference that changes every page rather than the
               tables on some of them.

               Three choices rather than a switch between two: nothing chosen is its own answer —
               the operating system's — and it is the one the page opens at, so a reader who has
               never picked has something to go back to. That third state is stored as the absence
               of the value rather than the word "system", which is why picking it clears the key
               instead of writing to it.

               Rendered at System and corrected to what was stored once the page is running, like
               the two below. Without scripting the select does nothing, so it is hidden until the
               script that drives it has run — and the page still follows the operating system,
               which is what System says anyway. *@
            <div class="preference" data-preference-row="theme" hidden>
                <div class="control">
                    <label for="theme">Theme</label>
                    <select id="theme" data-preference="theme">
                        <option value="system" selected>System</option>
                        <option value="light">Light</option>
                        <option value="dark">Dark</option>
                    </select>
                </div>
                <p class="hint">
                    How this application is coloured, in this browser. System follows the light or
                    dark setting the operating system asks for and changes with it.
                </p>
            </div>

            @* The same picker as the one under a table, carrying the same class, because it is the
               same choice: what is picked here is what that picker opens at, and what is picked
               there is what stands here afterwards. There is no form and nothing to submit — the
               select is the setting, and it is written down as it changes.

               Rendered at the default and corrected to what was stored once the page is running.
               The server has no way to read this browser's storage, so the alternative is a select
               that says nothing until it is opened. *@
            <div class="preference">
                <div class="control page-size">
                    <label for="rows-per-page">Rows per page</label>
                    <select id="rows-per-page" data-preference="rows-per-page">
                        @foreach (var option in InstanceQuery.PageSizes)
                        {
                            <option value="@option" selected="@(option == InstanceQuery.DefaultPageSize)">@option</option>
                        }
                    </select>
                </div>
                <p class="hint">
                    How much of a table one page holds, wherever a table is read. The picker under a
                    table sets the same thing and opens at whatever stands here.
                </p>
            </div>

            @* The same setting as the "Don't show this again" under the note itself, reachable
               without having to meet the note again to change one's mind — which is the whole
               difficulty with a dismissal: once hidden, the thing that offered to hide it is gone.
               Unchecked as rendered and corrected once the page is running, like the picker above.

               The box sits beside the label rather than inside it, so it stands where the picker
               above it does and the two rows are read the same way round. It is still the label's
               own control — for names it, so the words still toggle it. *@
            <div class="preference">
                <div class="control">
                    <label for="hide-ordering-notice">Hide the note about approximate ordering</label>
                    <input type="checkbox" id="hide-ordering-notice"
                           data-preference="hide-ordering-notice" />
                </div>
                <p class="hint">
                    Some stores cannot order a page fully and fall back to ordering by date alone. The
                    events are all there; rows written at the same moment can move between pages.
                </p>
            </div>
        </div>
    </section>
}

@code {

    [SupplyParameterFromQuery(Name = "message")]
    private string? Message { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    /// <summary>
    /// The three views the page offers, named as they appear in the address. Which one is showing is
    /// the address's to say, so a view can be linked to, bookmarked, and gone back to — and so the
    /// redirect after an upload or a refresh comes back to the tab the button was pressed on.
    /// </summary>
    private const string InstalledTab = "installed";

    private const string TypesTab = "types";

    /// <summary>
    /// This browser's own settings, which the server neither keeps nor is told about: the tab is
    /// only the page they are set on. Named in the address like the other two, so it is somewhere
    /// to be sent rather than a panel that has to be found.
    /// </summary>
    private const string PreferencesTab = "preferences";

    /// <summary>
    /// Which view the address asks for. Taken as text and matched against the two the page has, so
    /// anything else in the query string opens the one the page opens with rather than a blank page.
    /// </summary>
    [SupplyParameterFromQuery(Name = "tab")]
    private string? TabAsked { get; set; }

    private string Tab => (TabAsked ?? string.Empty).ToLowerInvariant() switch
    {
        TypesTab => TypesTab,
        PreferencesTab => PreferencesTab,
        _ => InstalledTab,
    };

    /// <summary>
    /// Who a change to the domain types reaches, said at the foot of each panel that can make one.
    /// </summary>
    /// <remarks>
    /// Uploading, removing and refreshing all change what everyone on this server resolves, so the
    /// warning belongs under both tabs that do them — and nowhere near Preferences, where it would
    /// be a contradiction rather than a caution. Set smaller and in italic because it is the
    /// condition the tab is read under rather than part of it: a footnote to the panel, not the
    /// sentence it opens with. Written once and rendered by whichever panel is showing, the same
    /// way the notice above it is.
    /// </remarks>
    private RenderFragment Shared =>
        @<p class="shared">
            Everyone using this server shares one set of domain types, so a change here changes what
            they see too; their open pages catch up when the browser is reloaded.
        </p>;

    /// <summary>
    /// What the last press did, rendered under the button that did it rather than at the top of the
    /// page, so the answer is read where the question was asked. Written once because both panels
    /// end the same way; only the showing panel renders it.
    /// </summary>
    private RenderFragment Notice =>
        @<text>
            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <p class="notice" role="status">@Message</p>
            }

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p class="alert" role="alert">@Error</p>
            }
        </text>;

    /// <summary>
    /// Whether the upload form should already be open. Asked for in the address so the page decides
    /// it, rather than the dialog's visibility depending on script having run.
    /// </summary>
    /// <remarks>
    /// Taken as text rather than a boolean: the value comes from the address bar, where anything at
    /// all can be typed, and a query string should not be able to fail the page.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "upload")]
    private string? UploadAsked { get; set; }

    private bool ShowUpload => UploadAsked is not null;

    /// <summary>The archive whose removal is being confirmed, when one is.</summary>
    [SupplyParameterFromQuery(Name = "delete")]
    private string? DeleteAsked { get; set; }

    /// <summary>The archive whose contents the address asks to see, when it asks for one.</summary>
    [SupplyParameterFromQuery(Name = "types")]
    private string? TypesAsked { get; set; }

    /// <summary>
    /// The archive the address asks to see the contents of, or null when it asks for nothing or
    /// for a name that is not installed — a name typed into the address bar opens nothing rather
    /// than an empty sheet.
    /// </summary>
    private InstalledArchive? Opened =>
        Archives.FirstOrDefault(archive => archive.Name == TypesAsked);

    /// <summary>The Installed tab with nothing asked for, which is what closes the sheet.</summary>
    private static string InstalledLink => $"settings?tab={InstalledTab}";

    /// <summary>
    /// The address that opens one archive's contents over the Installed tab. Lands on the sheet,
    /// so on a long list the reader arrives at what they opened rather than at the top of the
    /// page.
    /// </summary>
    private static string TypesLink(InstalledArchive archive) =>
        $"{InstalledLink}&types={Uri.EscapeDataString(archive.Name)}#{ArchiveTypesDialog.Anchor}";

    private DomainTypeCatalogue Catalogue => Types.Current;

    /// <summary>
    /// When the types showing were last read from the assemblies, or that they never have been.
    /// Written as a value rather than a branch in the markup: a conditional block in the middle of
    /// a sentence takes the space before it with it, and the sentence closes up.
    /// </summary>
    private string Registered => Catalogue.ReloadedUtc is { } reloaded
        ? $"Last registered {reloaded.ToLocalTime():g}."
        : "Not registered yet.";

    private IReadOnlyList<InstalledArchive> Archives { get; set; } = [];

    @* The model each column belongs to is said by its heading, so the labels no longer carry it.
       Events are counted per column as the ones that column's models apply, not as the whole bound
       set: one set is bound and either model may append from it, but what a column is read for is
       what its own models fold. An event both apply is counted in both, and the two columns
       therefore need not add up to the events found. *@
    @* Streams come last because they are the one row the other column cannot answer: a DCB
       boundary is a query over tags, not a place to put events. The five both models declare are
       listed first and in the same order, so the columns line up row for row and are read across;
       what only this model has is added under them rather than pushing that alignment down. *@
    @* The mark each row is drawn with is the site's mark for the thing counted, so a row here and
       the tile that leads to it are recognisably the same subject. An id takes the mark of what it
       identifies rather than one of its own: there is no id among the marks, and inventing one
       would put a drawing on this page that means nothing anywhere else on the site. The pair sits
       adjacent and is told apart by the name beside it, which is the row that names them both. *@
    private IReadOnlyList<(SectionKind Mark, string Label, int Count)> StreamedCounts => [
        (SectionKind.Events, "Events", Catalogue.StreamedEvents.Count),
        (SectionKind.Aggregates, "Aggregates", Catalogue.StreamedAggregates.Count),
        (SectionKind.Aggregates, "Aggregate ids", Catalogue.StreamedAggregateIds.Count),
        (SectionKind.Projections, "Projections", Catalogue.StreamedProjections.Count),
        (SectionKind.Projections, "Projection ids", Catalogue.StreamedProjectionIds.Count),
        (SectionKind.Streams, "Streams", Catalogue.StreamedStreamIds.Count)
    ];

    private IReadOnlyList<(SectionKind Mark, string Label, int Count)> DcbCounts => [
        (SectionKind.Events, "Events", Catalogue.DcbEvents.Count),
        (SectionKind.Aggregates, "Aggregates", Catalogue.DcbAggregates.Count),
        (SectionKind.Aggregates, "Aggregate ids", Catalogue.DcbAggregateIds.Count),
        (SectionKind.Projections, "Projections", Catalogue.DcbProjections.Count),
        (SectionKind.Projections, "Projection ids", Catalogue.DcbProjectionIds.Count)
    ];

    protected override void OnInitialized() => Archives = Store.InstalledArchives();

}
